package layouts

// HeadScripts owns the local Alpine.js + alpine-ajax script tags in one
// place. Both Shell and the standalone LoginPage render it, so the URLs
// (and version bumps) are defined once.
templ HeadScripts() {
	<script defer src="/static/alpine.min.js"></script>
	<script defer src="/static/alpine-ajax.min.js"></script>
}

templ Shell(title string, path string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-brand-ground">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · PortD</title>
			<link rel="stylesheet" href="/static/app.css"/>
			@HeadScripts()
		</head>
		<body class="min-h-full font-sans text-sm text-brand-ink antialiased bg-brand-ground">
			<div class="min-h-screen flex flex-col md:grid md:grid-cols-[250px_minmax(0,1fr)]">
				<aside class="hidden md:flex flex-col p-5 bg-white border-r border-brand-line" aria-label="Primary navigation">
					<a class="flex items-center px-2.5 pb-5 text-lg font-extrabold text-brand-navy tracking-tight hover:opacity-90 transition-opacity" href="/dashboard">
						Project Hub
					</a>
					<nav class="flex flex-col gap-1">
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/dashboard") } href="/dashboard">Overview</a>
						<p class="mt-5 mb-1 px-2.5 text-xs font-bold text-slate-400 tracking-wider uppercase">Projects</p>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/projects") } href="/projects">All projects</a>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/projects/tracking") } href="/projects/tracking">Project tracking</a>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/projects/new") } href="/projects/new">Add project</a>
						<p class="mt-5 mb-1 px-2.5 text-xs font-bold text-slate-400 tracking-wider uppercase">Infrastructure</p>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/ports") } href="/ports">Port table</a>
						<p class="mt-5 mb-1 px-2.5 text-xs font-bold text-slate-400 tracking-wider uppercase">People</p>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/interns") } href="/interns">Interns</a>
					</nav>
					<small class="mt-auto pt-4 border-t border-brand-line text-xs text-slate-400 px-2.5 block">Internal use only</small>
				</aside>
				<main class="flex-1 min-w-0 flex flex-col">
					<header class="h-16 flex items-center justify-between px-5 md:px-8 bg-white border-b border-brand-line">
						<strong class="text-base font-bold text-brand-navy">{ title }</strong>
						<form method="post" action="/logout">
							<button class="inline-flex items-center justify-center min-h-[36px] px-3.5 py-1.5 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer">Sign out</button>
						</form>
					</header>
					<div class="w-full max-w-6xl mx-auto p-5 md:p-8 flex-1">@body
</div>
				</main>
			</div>
		</body>
	</html>
}
