package layouts

// HeadScripts owns the local Alpine.js + alpine-ajax script tags in one
// place. Both Shell and the standalone LoginPage render it, so the URLs
// (and version bumps) are defined once.
templ HeadScripts() {
	<script defer src="/static/alpine.min.js"></script>
	<script defer src="/static/alpine-ajax.min.js"></script>
}

// ThemeScript reads the saved theme before first paint so dark mode never
// flashes, then exposes window.portdTheme.toggle() for the header button.
// ponytail: localStorage + prefers-color-scheme, no server-side preference yet.
templ ThemeScript() {
	<script>
		(function () {
			try {
				var t = localStorage.getItem("portd-theme");
				if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
					document.documentElement.classList.add("dark");
				}
			} catch (e) {}
			window.portdTheme = {
				toggle: function () {
					var dark = document.documentElement.classList.toggle("dark");
					try { localStorage.setItem("portd-theme", dark ? "dark" : "light"); } catch (e) {}
					var sun = document.getElementById("theme-icon-sun");
					var moon = document.getElementById("theme-icon-moon");
					if (sun && moon) { sun.style.display = dark ? "none" : ""; moon.style.display = dark ? "" : "none"; }
				},
				isDark: function () { return document.documentElement.classList.contains("dark"); }
			};
			document.addEventListener("DOMContentLoaded", function () {
				var dark = window.portdTheme.isDark();
				var sun = document.getElementById("theme-icon-sun");
				var moon = document.getElementById("theme-icon-moon");
				if (sun && moon) { sun.style.display = dark ? "none" : ""; moon.style.display = dark ? "" : "none"; }
			});
		})();
	</script>
}

templ ThemeToggle() {
	<button type="button" onclick="window.portdTheme.toggle()" aria-label="Basculer le mode sombre" title="Mode sombre" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-white hover:bg-slate-100 border border-slate-300 text-slate-600 transition-colors dark:bg-slate-800 dark:hover:bg-slate-700 dark:border-slate-600 dark:text-slate-300">
		<svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
		<svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" style="display:none" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
	</button>
}

templ Shell(title string, path string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="fr" class="h-full bg-brand-ground dark:bg-slate-900">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · PortD</title>
			@ThemeScript()
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/hub.css"/>
			@HeadScripts()
		</head>
		<body class="min-h-full font-sans text-sm text-brand-ink antialiased bg-brand-ground dark:bg-slate-900 dark:text-slate-200">
			<div class="min-h-screen flex flex-col md:grid md:grid-cols-[250px_minmax(0,1fr)]">
				<aside class="hidden md:flex flex-col p-5 bg-white border-r border-brand-line dark:bg-slate-800 dark:border-slate-700" aria-label="Navigation principale">
					<a class="flex items-center px-2.5 pb-5 text-lg font-extrabold text-brand-navy tracking-tight hover:opacity-90 transition-opacity dark:text-white" href="/dashboard">
						Centre de projets
					</a>
					<nav class="flex flex-col gap-1">
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/dashboard") } href="/dashboard">Aperçu</a>
						<p class="mt-5 mb-1 px-2.5 text-xs font-bold text-slate-400 tracking-wider uppercase">Projets</p>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/projects") } href="/projects">Projets</a>
						<p class="mt-5 mb-1 px-2.5 text-xs font-bold text-slate-400 tracking-wider uppercase">Infrastructure</p>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/ports") } href="/ports">Table des ports</a>
						<p class="mt-5 mb-1 px-2.5 text-xs font-bold text-slate-400 tracking-wider uppercase">Personnes</p>
						<a class={ "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm font-semibold transition-colors", navClass(path, "/interns") } href="/interns">Stagiaires</a>
					</nav>
					<small class="mt-auto pt-4 border-t border-brand-line text-xs text-slate-400 px-2.5 block dark:border-slate-700">Usage interne uniquement</small>
				</aside>
				<main class="flex-1 min-w-0 flex flex-col">
					<header class="h-16 flex items-center justify-between px-5 md:px-8 bg-white border-b border-brand-line dark:bg-slate-800 dark:border-slate-700">
						<strong class="text-base font-bold text-brand-navy dark:text-white">{ title }</strong>
						<div class="flex items-center gap-2">
							@ThemeToggle()
							<a href="/profile" aria-label="Profil" title="Profil" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-white hover:bg-slate-100 border border-slate-300 text-slate-600 transition-colors dark:bg-slate-800 dark:hover:bg-slate-700 dark:border-slate-600 dark:text-slate-300">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
							</a>
						</div>
					</header>
					<div class="hub-content">@body
</div>
				</main>
			</div>
		</body>
	</html>
}
