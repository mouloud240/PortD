package pages

import (
	"strconv"

	"github.com/portd/views/components"
	"github.com/portd/views/layouts"
)

templ DashboardPage(data DashboardData) {
	@layouts.Shell("Aperçu", "/dashboard", dashboardBody(data))
}

templ dashboardBody(data DashboardData) {
	<div class="page-heading">
		<div>
			<h1>Aperçu</h1>
			<p>Suivez les projets des stagiaires et les ports serveur attribués.</p>
		</div>
		<a class="button primary" href="/projects/new">+ Ajouter un projet</a>
	</div>
	<div class="stat-grid">
		<article><span>Projets actifs</span><strong>{ strconv.Itoa(data.ActiveProjects) }</strong><small>Non archivés</small></article>
		<article><span>Services en cours</span><strong>{ strconv.Itoa(data.LiveServices) }<em>/{ strconv.Itoa(data.TotalServices) }</em></strong><small>État de joignabilité</small></article>
		<article>
			<span>Ports utilisés</span><strong>{ strconv.Itoa(data.AssignedPorts) }</strong>
			if data.UnknownPorts > 0 {
				<small class="warning">{ strconv.Itoa(data.UnknownPorts) } inconnus</small>
			} else {
				<small>Tous enregistrés</small>
			}
		</article>
		<article><span>Stagiaires actifs</span><strong>{ strconv.Itoa(data.ActiveInterns) }</strong><small>Stages en cours</small></article>
	</div>
	<section class="panel">
		<div class="panel-head">
			<div>
				<h2>Projets par étape</h2>
				<p>Projets actifs par étape, hors archivés.</p>
			</div>
			<a class="table-action" href="/projects">Tout voir</a>
		</div>
		<div class="panel-body panel-body-padded">
			<ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
				for _, bar := range data.Lifecycle {
					<li style="display:flex;align-items:center;gap:12px;">
						<span class={ "state-pill " + bar.Class } style="min-width:88px;">{ bar.Label }</span>
						<span style="flex:1;height:10px;border-radius:999px;background:#eef2f6;overflow:hidden;" role="presentation">
							<span style={ "display:block;height:100%;border-radius:999px;background:" + bar.Color + ";width:" + strconv.Itoa(bar.Percent) + "%;" }></span>
						</span>
						<strong style="min-width:24px;text-align:right;">{ strconv.Itoa(bar.Count) }</strong>
					</li>
				}
			</ul>
		</div>
	</section>
	<div class="two-column">
		<section class="panel">
			<div class="panel-head">
				<div>
					<h2>Projets actuels</h2>
					<p>Ouvrez un projet interne ou consultez sa configuration.</p>
				</div>
				<a class="table-action" href="/projects">Tout voir</a>
			</div>
			<div class="panel-body table-wrap">
				<table class="hub-table">
					<thead>
						<tr>
							<th>Projet</th>
							<th>Statut</th>
							<th>Port principal</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, item := range data.Projects {
							<tr>
								<td><a class="project-name" href={ "/projects/" + item.Slug }>{ item.Name }</a></td>
								<td><span class={ "badge " + item.StatusClass }>{ item.StatusLabel }</span></td>
								<td><code class="hub-code">{ item.MainPort }</code></td>
								<td><a class="table-action" href={ "/projects/" + item.Slug }>Voir</a></td>
							</tr>
						}
						if len(data.Projects) == 0 {
							<tr>
								<td colspan="4">
									<div class="empty-state">Aucun projet actif pour le moment.</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<section class="panel activity">
			<div class="panel-head">
				<div>
					<h2>Activité récente</h2>
				</div>
				<a class="table-action" href="/activity">Tout voir</a>
			</div>
			<ol>
				for _, item := range data.Recent {
					<li class={ activityLiClass(item.Failed) }>
						<time>{ item.Time }</time>
						<span>
							<b>{ item.EventLabel }</b> { item.Entity }
							if item.Detail != "" {
								{ " — " + item.Detail }
							}
						</span>
					</li>
				}
				if len(data.Recent) == 0 {
					<li><span>Aucune activité enregistrée pour le moment.</span></li>
				}
			</ol>
		</section>
	</div>
}

templ PlaceholderPage(title string, path string) {
	@layouts.Shell(title, path, placeholderBody(title))
}

templ ActivityPage(data ActivityData) {
	@layouts.Shell(data.Title, data.Path, activityBody(data))
}

templ activityBody(data ActivityData) {
	<div class="page-heading">
		<div>
			<h1>Activité</h1>
			<p>Historique des événements projets, exécution, ports, stagiaires et sessions.</p>
		</div>
	</div>
	<section class="panel">
		<form class="toolbar" method="get">
			<input name="q" value={ data.Search } type="search" placeholder="Rechercher une entité ou un détail" aria-label="Rechercher dans l'activité"/>
			<select name="category" aria-label="Filtrer par catégorie" onchange="this.form.requestSubmit()">
				<option value="" selected?={ data.Category == "" }>Toutes les catégories</option>
				for _, category := range data.Categories {
					<option value={ category } selected?={ data.Category == category }>{ CategoryName(category) }</option>
				}
			</select>
			<select name="event_type" aria-label="Filtrer par événement" onchange="this.form.requestSubmit()">
				<option value="" selected?={ data.EventType == "" }>Tous les événements</option>
				for _, event := range data.EventTypes {
					<option value={ event } selected?={ data.EventType == event }>{ event }</option>
				}
			</select>
			<select name="outcome" aria-label="Filtrer par résultat" onchange="this.form.requestSubmit()">
				<option value="" selected?={ data.Outcome == "" }>Tous les résultats</option>
				<option value="success" selected?={ data.Outcome == "success" }>Succès</option>
				<option value="failure" selected?={ data.Outcome == "failure" }>Échec</option>
			</select>
			<button class="button secondary" type="submit">Rechercher</button>
		</form>
		<div class="panel-body table-wrap">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Heure</th>
						<th>Événement</th>
						<th>Entité</th>
						<th>Auteur</th>
						<th>Résultat</th>
						<th>Détail</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range data.Items {
						<tr>
							<td><time>{ item.Time }</time></td>
							<td>
								<div><strong>{ item.EventLabel }</strong></div>
								<span class={ "badge " + item.CategoryClass }>{ item.Category }</span>
							</td>
							<td>{ item.Entity }</td>
							<td><code class="hub-code" title={ item.Actor }>{ item.ActorShort }</code></td>
							<td><span class={ "badge " + item.OutcomeClass }>{ item.Outcome }</span></td>
							<td>{ item.Detail }</td>
						</tr>
					}
					if len(data.Items) == 0 {
						<tr>
							<td colspan="6">
								<div class="empty-state">Aucune activité ne correspond à ces filtres.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="panel-body">
			if data.HasPrev {
				<form method="get">
					<input type="hidden" name="q" value={ data.Search }/>
					<input type="hidden" name="category" value={ data.Category }/>
					<input type="hidden" name="event_type" value={ data.EventType }/>
					<input type="hidden" name="outcome" value={ data.Outcome }/>
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page - 1) }/>
					<button class="button secondary" type="submit">← Plus récents</button>
				</form>
			}
			if data.HasNext {
				<form method="get">
					<input type="hidden" name="q" value={ data.Search }/>
					<input type="hidden" name="category" value={ data.Category }/>
					<input type="hidden" name="event_type" value={ data.EventType }/>
					<input type="hidden" name="outcome" value={ data.Outcome }/>
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page + 1) }/>
					<button class="button secondary" type="submit">Plus anciens →</button>
				</form>
			}
		</div>
	</section>
}

templ placeholderBody(title string) {
	<div class="space-y-1">
		<h1 class="text-2xl font-bold text-brand-navy dark:text-white">{ title }</h1>
		<p class="text-brand-muted text-sm">Cette page attend sa fonctionnalité.</p>
	</div>
}

templ LoginPage(errorMessage string) {
	<!DOCTYPE html>
	<html lang="fr" class="h-full bg-brand-ground dark:bg-slate-900">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Connexion · PortD</title>
			@layouts.ThemeScript()
			<link rel="stylesheet" href="/static/app.css"/>
			@layouts.HeadScripts()
		</head>
		<body class="min-h-full font-sans text-sm text-brand-ink antialiased bg-brand-ground flex items-center justify-center p-4 dark:bg-slate-900 dark:text-slate-200">
			<main class="w-full max-w-sm bg-white border border-brand-line rounded-lg p-6 shadow-sm dark:bg-slate-800 dark:border-slate-700">
				<h1 class="text-2xl font-bold text-brand-navy dark:text-white">PortD</h1>
				<p class="text-brand-muted text-sm mt-0.5 mb-5 dark:text-slate-400">Connectez-vous pour gérer les projets de stage.</p>
				if errorMessage != "" {
					<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium dark:bg-red-950 dark:border-red-800 dark:text-red-300" role="alert">
						{ errorMessage }
					</div>
				}
				<form method="post" action="/login" class="space-y-4">
					<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
						Nom d'utilisateur
						<input
							name="username"
							required
							autocomplete="username"
							class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200"
						/>
					</label>
					<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
						Mot de passe
						@components.PasswordField("password", "current-password", true)
					</label>
					<button
						type="submit"
						class="w-full mt-2 inline-flex items-center justify-center min-h-[38px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover text-white text-sm font-bold rounded-lg transition-colors cursor-pointer shadow-sm"
					>
						Se connecter
					</button>
				</form>
			</main>
		</body>
	</html>
}

templ ProfilePage(data ProfileData) {
	@layouts.Shell(data.Title, data.Path, profileBody(data))
}

templ profileBody(data ProfileData) {
	<div class="space-y-1 mb-6">
		<h1 class="text-2xl font-bold text-brand-navy dark:text-white">Profil</h1>
		<p class="text-brand-muted text-sm dark:text-slate-400">Connecté en tant que <strong>{ data.Role }</strong>.</p>
	</div>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	if data.IsAdmin {
		<section class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4 dark:bg-slate-800 dark:border-slate-700">
			<dl class="space-y-3">
				<div>
					<dt class="text-xs font-bold text-slate-500 uppercase tracking-wider dark:text-slate-400">Nom d'utilisateur</dt>
					<dd class="mt-0.5 text-sm font-bold text-brand-navy dark:text-white">{ data.Username }</dd>
				</div>
				<div>
					<dt class="text-xs font-bold text-slate-500 uppercase tracking-wider dark:text-slate-400">Rôle</dt>
					<dd class="mt-0.5 text-sm text-slate-700 dark:text-slate-300">{ data.Role }</dd>
				</div>
			</dl>
			<p class="text-xs text-slate-400">Le compte administrateur est géré par la configuration du serveur.</p>
			<form method="post" action="/logout">
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-slate-600 dark:text-slate-200">Se déconnecter</button>
			</form>
		</section>
	} else {
		<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4 dark:bg-slate-800 dark:border-slate-700" method="post" action="/profile" x-data="{ busy: false }" @submit="busy = true">
			<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
				Nom complet
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="full_name" required value={ data.FullName }/>
			</label>
			<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
				Nom d'utilisateur
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="identifier" required value={ data.Username }/>
			</label>
			<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
				E-mail
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" type="email" name="email" value={ data.Email }/>
			</label>
			<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Enregistrer</button>
		</form>
		<section class="max-w-xl mt-4 bg-white border border-brand-line rounded-lg p-6 shadow-sm dark:bg-slate-800 dark:border-slate-700">
			<form method="post" action="/logout">
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-slate-600 dark:text-slate-200">Se déconnecter</button>
			</form>
		</section>
	}
}

templ InternsPage(title string, path string, search string, state string, items []InternListItem) {
	@layouts.Shell(title, path, internsBody(search, state, items))
}

templ internsBody(search string, state string, items []InternListItem) {
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
		<div>
			<h1 class="text-2xl font-bold text-brand-navy dark:text-white">Stagiaires</h1>
			<p class="text-brand-muted text-sm mt-0.5 dark:text-slate-400">Créez des comptes stagiaires et voyez leurs projets.</p>
		</div>
		<a class="inline-flex items-center justify-center min-h-[36px] px-3.5 py-2 bg-brand-blue hover:bg-brand-blue-hover text-white text-sm font-bold rounded-lg transition-colors shadow-sm cursor-pointer" href="/interns/new">+ Ajouter un stagiaire</a>
	</div>
	<section class="bg-white border border-brand-line rounded-lg shadow-sm overflow-hidden dark:bg-slate-800 dark:border-slate-700">
		<form class="flex flex-wrap items-center gap-3 p-4 border-b border-brand-line dark:border-slate-700" method="get" x-target="intern-table">
			<input class="w-full max-w-md flex-1 min-w-[200px] px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 placeholder-slate-400 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="q" value={ search } placeholder="Rechercher des stagiaires" aria-label="Rechercher des stagiaires"/>
			<select name="state" aria-label="Filtrer par état" onchange="this.form.requestSubmit()" class="px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200">
				<option value="all" selected?={ state == "" || state == "all" }>Tous les états</option>
				<option value="active" selected?={ state == "active" }>Actif</option>
				<option value="inactive" selected?={ state == "inactive" }>Inactif</option>
			</select>
			<button class="inline-flex items-center justify-center min-h-[36px] px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-slate-600 dark:text-slate-200">Rechercher</button>
		</form>
		<div id="intern-table" class="overflow-x-auto">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="border-b border-brand-line bg-slate-50/75 dark:border-slate-700 dark:bg-slate-900/60">
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider dark:text-slate-400">Nom</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider dark:text-slate-400">Nom d'utilisateur</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider dark:text-slate-400">E-mail</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider dark:text-slate-400">État</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100 dark:divide-slate-700">
					for _, item := range items {
						<tr class="hover:bg-slate-50/60 transition-colors dark:hover:bg-slate-700/40">
							<td class="px-5 py-3.5 text-sm font-bold text-brand-navy whitespace-nowrap dark:text-slate-100">
								<a class="text-brand-blue hover:underline dark:text-blue-400" href={ "/interns/" + item.ID }>{ item.FullName }</a>
							</td>
							<td class="px-5 py-3.5 text-sm whitespace-nowrap">
								<code class="font-mono text-xs px-2 py-0.5 bg-slate-100 border border-slate-200 rounded text-slate-700 dark:bg-slate-900 dark:border-slate-600 dark:text-slate-300">{ item.Username }</code>
							</td>
							<td class="px-5 py-3.5 text-sm text-slate-600 whitespace-nowrap dark:text-slate-400">{ item.Email }</td>
							<td class="px-5 py-3.5 text-sm whitespace-nowrap">
								if item.Active {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green dark:bg-green-950 dark:text-green-300">
										<span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
										Actif
									</span>
								} else {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">
										<span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
										Inactif
									</span>
								}
							</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan="4" class="px-5 py-12 text-center text-brand-muted text-sm dark:text-slate-400">Aucun stagiaire trouvé.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ ProjectsPage(title string, path string, search string, lifecycle string, live string, items []ProjectListItem, detected []DetectItem, showDetect bool) {
	@layouts.Shell(title, path, projectsBody(search, lifecycle, live, items, detected, showDetect))
}

templ projectsBody(search string, lifecycle string, live string, items []ProjectListItem, detected []DetectItem, showDetect bool) {
	<div class="page-heading">
		<div>
			<h1>Projets</h1>
			<p>Recherchez dans le registre central et ouvrez une URL interne disponible.</p>
		</div>
		<div>
			<a class="button secondary" href="/projects/detect">Détecter sur le disque</a>
			<a class="button primary" href="/projects/new">+ Ajouter un projet</a>
		</div>
	</div>
	<section class="panel">
		<form class="toolbar" method="get" x-target="project-table">
			<input name="q" value={ search } type="search" placeholder="Rechercher projets, responsables ou ports" aria-label="Rechercher des projets"/>
			<select name="lifecycle_status" aria-label="Filtrer par cycle de vie" onchange="this.form.requestSubmit()">
				<option value="" selected?={ lifecycle == "" }>Tous les cycles de vie</option>
				<option value="draft" selected?={ lifecycle == "draft" }>Brouillon</option>
				<option value="ready" selected?={ lifecycle == "ready" }>Prêt</option>
				<option value="running" selected?={ lifecycle == "running" }>En cours</option>
				<option value="stopped" selected?={ lifecycle == "stopped" }>Arrêté</option>
				<option value="failed" selected?={ lifecycle == "failed" }>Échoué</option>
				<option value="archived" selected?={ lifecycle == "archived" }>Archivé</option>
			</select>
			<select name="is_live" aria-label="Filtrer par état" onchange="this.form.requestSubmit()">
				<option value="" selected?={ live == "" }>Tous les statuts</option>
				<option value="true" selected?={ live == "true" }>En cours</option>
				<option value="false" selected?={ live == "false" }>Hors ligne</option>
			</select>
			<button class="button secondary" type="submit">Rechercher</button>
		</form>
		<div class="panel-body table-wrap" id="project-table">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Projet</th>
						<th>Stagiaire</th>
						<th>Statut</th>
						<th>Port principal</th>
						<th>Suivi</th>
						<th>URL interne</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, item := range items {
						<tr>
							<td>
								<a class="project-name" href={ "/projects/" + item.Slug }>{ item.Name }</a>
							</td>
							<td>{ item.Interns }</td>
							<td>
								<span class={ "badge " + item.StatusClass }>{ item.StatusLabel }</span>
								if item.MissingStartup {
									<span class="badge warning">Sans fichier de démarrage</span>
								}
							</td>
							<td>
								<code class="hub-code">{ item.MainPort }</code>
							</td>
							<td>
								<span class={ "state-pill " + item.LifecycleClass }>{ item.LifecycleLabel }</span>
							</td>
							<td>
								<span class="badge neutral">{ item.AccessLabel }</span>
								<a class="table-action" href={ item.URL } target="_blank" rel="noreferrer">{ item.URLLabel } ↗</a>
							</td>
							<td>
								<a class="table-action" href={ "/projects/" + item.Slug }>Voir</a>
							</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan="7">
								<div class="empty-state">Aucun projet ne correspond à votre recherche.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	if showDetect {
		@detectModal(detected)
	}
}

templ detectModal(detected []DetectItem) {
	<div class="detect-overlay" x-data="{ query: '' }" @keydown.escape.window="window.location.href = '/projects'">
		<div class="detect-backdrop" aria-hidden="true" @click="window.location.href = '/projects'"></div>
		<div class="detect-dialog panel" role="dialog" aria-modal="true" aria-labelledby="detect-title">
			<div class="panel-head">
				<div>
					<h2 id="detect-title">Projets détectés</h2>
					<p>Sélectionnez les dossiers à ajouter. Ceux déjà enregistrés sont grisés.</p>
				</div>
				<a class="table-action" href="/projects" aria-label="Fermer">✕</a>
			</div>
			<form method="post" action="/projects/detect" x-ref="detectForm">
				<div class="detect-toolbar">
					<input
						type="search"
						name="detect-q"
						placeholder="Rechercher des dossiers"
						aria-label="Rechercher parmi les dossiers détectés"
						autofocus
						x-model="query"
					/>
					<button
						class="button secondary"
						type="button"
						@click="$refs.detectForm.querySelectorAll('input[name=slugs]:not(:disabled)').forEach(c => c.checked = true)"
					>Tout sélectionner</button>
					<button
						class="button secondary"
						type="button"
						@click="$refs.detectForm.querySelectorAll('input[name=slugs]:not(:disabled)').forEach(c => c.checked = false)"
					>Tout désélectionner</button>
				</div>
				<ul class="detect-list">
					for _, item := range detected {
						<li
							class={ "detect-row", templ.KV("is-existing", item.Exists) }
							data-search={ item.Name + " " + item.Slug }
							x-show="!query || $el.dataset.search.toLowerCase().includes(query.toLowerCase())"
						>
							<label>
								if item.Exists {
									<input type="checkbox" name="slugs" value={ item.Slug } disabled/>
								} else {
									<input type="checkbox" name="slugs" value={ item.Slug } checked/>
								}
								<span class="detect-name">{ item.Name }</span>
								<code class="hub-code">{ item.Slug }</code>
							</label>
							if item.Exists {
								<span class="badge neutral">Déjà ajouté</span>
							}
						</li>
					}
					if len(detected) == 0 {
						<li class="detect-empty">Aucun dossier trouvé sur le disque.</li>
					}
				</ul>
				<div class="detect-actions">
					<a class="button secondary" href="/projects">Annuler</a>
					<button class="button primary" type="submit">Ajouter la sélection</button>
				</div>
			</form>
		</div>
	</div>
}

templ PortsPage(data PortsPageData) {
	@layouts.Shell("Gestion des ports", data.Path, portsBody(data))
}

templ portsBody(data PortsPageData) {
	<div class="page-heading ports-page-heading">
		<div>
			<h1>Gestion des ports</h1>
			<p>Voyez quels ports sont utilisés et à quel projet ils appartiennent.</p>
		</div>
		<a class="button secondary" href="/ports">Actualiser</a>
	</div>
	<section class="panel ports-panel">
		<div class="ports-panel-intro">
			<div>
				<strong>Analyse actuelle</strong>
				<p>Lecture seule. PortD ne résout pas les conflits automatiquement.</p>
			</div>
			<div class="ports-scan-meta">
				if data.CheckedAt != "" {
					<span>Dernière vérification <strong>{ data.CheckedAt }</strong></span>
				}
				if data.Unknown > 0 {
					<span class="badge warning">{ data.Unknown } non enregistrés</span>
				}
			</div>
		</div>
		<div class="panel-body table-wrap">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Port</th>
						<th>Processus</th>
						<th>Projet enregistré</th>
						<th>Stagiaire</th>
						<th>État</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr>
							<td><code class="hub-code">{ row.Port }</code></td>
							<td>{ row.Process }</td>
							<td>
								if row.Registered {
									<a class="project-name" href={ "/projects/" + row.ProjectSlug }>{ row.Project }</a>
								} else {
									—
								}
							</td>
							<td>{ row.Interns }</td>
							<td>
								if row.Registered {
									<span class="badge running">Enregistré</span>
								} else {
									<span class="badge warning">Non enregistré</span>
								}
							</td>
						</tr>
					}
					if len(data.Rows) == 0 {
						<tr>
							<td colspan="5">
								<div class="empty-state">Aucune donnée de port. Cliquez sur Actualiser pour analyser.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="panel ports-panel">
		<div class="ports-panel-intro">
			<div>
				<strong>Réservés, sans écoute</strong>
				<p>Attribués à un projet mais aucun processus détecté. Généralement un projet arrêté.</p>
			</div>
			<div class="ports-scan-meta">
				if len(data.Reserved) > 0 {
					<span class="badge neutral">{ strconv.Itoa(len(data.Reserved)) } réservés</span>
				}
			</div>
		</div>
		<div class="panel-body table-wrap">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Port</th>
						<th>Projet enregistré</th>
						<th>Stagiaire</th>
						<th>État</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Reserved {
						<tr>
							<td><code class="hub-code">{ row.Port }</code></td>
							<td>
								<a class="project-name" href={ "/projects/" + row.ProjectSlug }>{ row.Project }</a>
							</td>
							<td>{ row.Interns }</td>
							<td><span class="badge neutral">Réservé</span></td>
						</tr>
					}
					if len(data.Reserved) == 0 {
						<tr>
							<td colspan="4">
								<div class="empty-state">Aucun port réservé. Tous les ports attribués sont en écoute.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ ProjectFormPage(data ProjectFormData) {
	@layouts.Shell(data.Title, data.Path, projectFormBody(data))
}

templ ProjectDetailPage(data ProjectDetailData) {
	@layouts.Shell(data.Name, data.Path, projectDetailBody(data))
}

templ projectDetailBody(data ProjectDetailData) {
	<div class="project-detail">
		<a class="breadcrumb" href="/projects">Projets / <span>{ data.Name }</span></a>
		<div class="project-hero">
			<div>
				<div class="title-row">
					<h1>{ data.Name }</h1>
					<span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span>
					<span class={ "state-pill " + data.LifecycleClass }>{ data.LifecycleLabel }</span>
				</div>
				<a href={ data.URL } target="_blank" rel="noreferrer">{ data.URLLabel } ↗</a>
				<p class="project-hero-meta">Géré par { data.Owners } · Port principal <code class="hub-code">{ data.MainPort }</code></p>
				if data.Description != "" {
					<p>{ data.Description }</p>
				}
			</div>
			<div class="project-hero-actions">
				<a class="button secondary" href={ "/projects/" + data.Slug + "/edit" }>Modifier</a>
				<a class="button primary" href={ data.URL } target="_blank" rel="noreferrer">Ouvrir le projet ↗</a>
			</div>
		</div>
		<div class="detail-grid">
			<section class="panel detail-panel">
				<div class="panel-head"><h2>Détails du projet</h2></div>
				<dl class="hub-dl">
					<div>
						<dt>Responsable</dt>
						<dd>{ data.Owners }</dd>
					</div>
					<div>
						<dt>Créé</dt>
						<dd>{ data.CreatedAt }</dd>
					</div>
					<div>
						<dt>Dernière mise à jour</dt>
						<dd>{ data.UpdatedAt }</dd>
					</div>
				</dl>
			</section>
			<section class="panel detail-panel">
				<div class="panel-head">
					<div>
						<h2>Exécution</h2>
						<p>Démarrez ou arrêtez le projet avec son fichier de démarrage.</p>
					</div>
					<span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span>
				</div>
				<div class="panel-body panel-body-padded runtime-control">
					if data.RuntimeError != "" {
						<div class="runtime-alert" role="alert">{ data.RuntimeError }</div>
					}
					<div class="runtime-control-row">
						<div>
							if data.RuntimeState == "running" {
								<strong>En cours</strong>
							} else if data.RuntimeState == "starting" {
								<strong>Démarrage</strong>
							} else if data.RuntimeState == "stopping" {
								<strong>Arrêt</strong>
							} else if data.RuntimeState == "failed" {
								<strong>Échoué</strong>
							} else {
								<strong>Arrêté</strong>
							}
							if data.RuntimePID != "0" {
								<p>Le processus <code class="hub-code">n°{ data.RuntimePID }</code> est géré par PortD.</p>
							} else {
								<p>Aucun processus géré en cours.</p>
							}
						</div>
						if data.RuntimeState == "running" || data.RuntimeState == "stopping" {
							<form method="post" action={ "/projects/" + data.Slug + "/runtime/stop" } x-data="{ busy: false }" @submit="busy = true">
								<button class="button danger" type="submit" :disabled="busy || '{ data.RuntimeState }' === 'stopping'">
									<span x-show="!busy">Arrêter le projet</span><span x-show="busy" x-cloak>Arrêt…</span>
								</button>
							</form>
						} else {
							<form method="post" action={ "/projects/" + data.Slug + "/runtime/start" } x-data="{ busy: false }" @submit="busy = true">
								<button class="button primary" type="submit" :disabled="busy || '{ data.RuntimeState }' === 'starting'">
									<span x-show="!busy">Démarrer le projet</span><span x-show="busy" x-cloak>Démarrage…</span>
								</button>
							</form>
						}
					</div>
					<div class="runtime-file">
						<span>Fichier d'exécution</span>
						<code class="hub-code">{ data.RuntimeFile }</code>
						if data.MissingStartup {
							<span class="badge warning">Aucun start.sh ou start.bat dans le dossier du projet</span>
						}
						<form class="runtime-configure" method="post" action={ "/projects/" + data.Slug + "/runtime/configure" }>
							<label class="sr-only" for="startup-command">Chemin du fichier de démarrage</label>
							<input id="startup-command" name="startup_command" value={ data.RuntimeFile } placeholder="start.sh ou start.bat" autocomplete="off"/>
							<button class="button secondary" type="submit">Enregistrer</button>
						</form>
						<ul class="mt-2 text-xs text-brand-muted list-disc ml-5 space-y-1">
							<li><strong>Windows :</strong> gardez une commande serveur au premier plan dans le fichier bat pour que PortD puisse l'arrêter.</li>
							<li>Évitez <code>start ... cmd /k</code>, <code>/min</code> ou <code>pause</code> : le processus réel survit alors à l'arrêt.</li>
							<li>Pour <code>npm</code>/<code>uvicorn</code> en arrière-plan, utilisez <code>start /b ""</code> dans la même fenêtre ; sinon séparez backend et frontend en deux projets PortD.</li>
						</ul>
					if data.RuntimeState == "failed" {
						<p class="runtime-error">Le processus s'est arrêté de façon inattendue. Vérifiez le fichier et les journaux avant de réessayer.</p>
					}
				</div>
				</div>
				<dl class="hub-dl four-up">
					<div>
						<dt>Port principal</dt>
						<dd><code class="hub-code">{ data.MainPort }</code></dd>
					</div>
					<div>
						<dt>Statut</dt>
						<dd><span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span></dd>
					</div>
					<div>
						<dt>Observé</dt>
						<dd>
							if data.IsLive {
								<span class="badge running">En ligne</span>
							} else {
								<span class="badge neutral">Hors ligne</span>
							}
						</dd>
					</div>
				</dl>
			</section>
		</div>
		<section class="panel detail-panel access-panel" x-data="{ selectedFramework: '', copied: false }">
			<div class="panel-head">
				<div>
					<h2>Accès au projet</h2>
					<p>Choisissez l'URL qui correspond à la gestion du chemin de base par votre application.</p>
				</div>
				<span class="badge neutral">{ data.Access.ModeLabel }</span>
			</div>
			<div class="panel-body panel-body-padded">
				if !data.Access.ProxyAvailable {
					<div class="runtime-alert mb-4" role="status">Proxy indisponible — Caddy ne répond pas. Les URL affichées utilisent le mode direct en attendant son retour.</div>
				}
				<div class="access-options">
					<div class="access-option" data-active?={ data.Access.Mode == "direct" }>
						<div class="access-option-head"><strong>Direct</strong><span class="state-pill ready">Sans modification</span></div>
						<code class="hub-code access-url">{ data.Access.DirectURL }</code>
						<p>Utilise directement le serveur et le port principal. Aucune configuration Caddy, DNS ou chemin de base requise.</p>
						<a class="button secondary" href={ data.Access.DirectURL } target="_blank" rel="noreferrer">Ouvrir l'URL directe ↗</a>
					</div>
					<div class="access-option" data-active?={ data.Access.Mode == "proxied" }>
						<div class="access-option-head"><strong>Via proxy</strong><span class="state-pill ready">Basée sur le chemin</span></div>
						<code class="hub-code access-url">{ data.Access.ProxiedURL }</code>
						<p>Utilise l'URL PortD partagée. Configurez le chemin de base pour la navigation et les ressources.</p>
						<a class="button secondary" href={ data.Access.ProxiedURL } target="_blank" rel="noreferrer">Ouvrir l'URL proxy ↗</a>
					</div>
				</div>
				<div class="quickstarts">
					<div class="panel-head access-subhead">
						<div><h3>Démarrages rapides par framework</h3><p>Sélectionnez votre framework pour voir la configuration en une ligne.</p></div>
					</div>
					<div class="quickstart-grid">
						for _, item := range data.Access.Quickstarts {
							<button class="quickstart" type="button" :class={ "selectedFramework === '" + item.Key + "' ? 'is-selected' : ''" } @click={ "selectedFramework = '" + item.Key + "'" }>
								<div class="quickstart-title">
									<strong>{ item.Name }</strong>
									if item.NoConfig {
										<span class="state-pill ready">Sans config</span>
									} else {
										<span class="state-pill draft">Config</span>
									}
								</div>
								<p>{ item.Description }</p>
								<span class="quickstart-action">Voir la configuration →</span>
							</button>
						}
					</div>
				</div>
				<div class="quickstart-instructions" x-cloak x-show="selectedFramework !== ''">
					for _, item := range data.Access.Quickstarts {
						<div class="quickstart-instruction" x-show={ "selectedFramework === '" + item.Key + "'" }>
							<div class="quickstart-instruction-head">
								<div><strong>{ item.Name }</strong><p>{ item.Description }</p><span class="quickstart-file">Modifier <code>{ item.File }</code></span></div>
								<button class="table-action" type="button" @click="navigator.clipboard.writeText($el.closest('.quickstart-instruction').querySelector('.quickstart-code').textContent); copied = true">Copier la configuration</button>
							</div>
							<pre class="quickstart-code"><code>{ item.Snippet }</code></pre>
						</div>
					}
				</div>
				<div class="ai-help">
					<div>
						<strong>Besoin d'aide ?</strong>
						<p>Collez cette invite dans votre agent IA et il vous guidera pour la plus petite modification adaptée.</p>
					</div>
					<textarea class="ai-prompt" readonly x-ref="aiPrompt">{ data.Access.AIPrompt }</textarea>
					<button class="button secondary" type="button" @click="navigator.clipboard.writeText($refs.aiPrompt.value); copied = true">Copier l'invite</button>
				</div>
				<p class="access-fallback"><strong>Navigation cassée en mode proxy ?</strong> Utilisez le mode direct depuis Modifier, ou ouvrez l'URL directe ci-dessus sans changer votre projet.</p>
			</div>
		</section>
		<section class="panel detail-panel" id="ports" x-data="{ confirming: '' }">
			<div class="panel-head">
				<div>
					<h2>Ports</h2>
					<p>Seul le port principal reçoit un lien public. Tout se passe ici.</p>
				</div>
			</div>
			<div class="panel-body panel-body-padded">
				if data.PortError != "" {
					<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
						{ data.PortError }
					</div>
				}
				if len(data.AllocatedPorts) == 0 {
					<p class="text-sm text-brand-muted mb-4">Aucun port attribué pour le moment.</p>
				} else {
					<ul class="flex flex-col gap-2 mb-5">
						for _, port := range data.AllocatedPorts {
							<li class="flex flex-wrap items-center gap-2">
								<code class="hub-code">{ port.Port }</code>
								if port.IsMain {
									<span class="port main">principal</span>
								} else {
									<span class="port">interne</span>
									<form method="post" action={ "/projects/" + data.Slug + "/ports/promote" }>
										<input type="hidden" name="port" value={ port.Port }/>
										<input type="hidden" name="next" value={ "/projects/" + data.Slug + "#ports" }/>
										<button class="table-action" type="submit">Principal</button>
									</form>
									<form method="post" action={ "/projects/" + data.Slug + "/ports/release" } x-show="confirming !== '{ port.Port }'">
										<input type="hidden" name="port" value={ port.Port }/>
										<input type="hidden" name="next" value={ "/projects/" + data.Slug + "#ports" }/>
										<button class="link-danger" type="button" @click={ "confirming = '" + port.Port + "'" }>Libérer</button>
									</form>
									<div class="flex items-center gap-2" x-show={ "confirming === '" + port.Port + "'" } x-cloak>
										<span class="text-sm text-slate-600 dark:text-slate-400">Libérer { port.Port } ?</span>
										<form method="post" action={ "/projects/" + data.Slug + "/ports/release" }>
											<input type="hidden" name="port" value={ port.Port }/>
											<input type="hidden" name="next" value={ "/projects/" + data.Slug + "#ports" }/>
											<button class="button danger" type="submit">Confirmer</button>
										</form>
										<button class="button secondary" type="button" @click="confirming = ''">Annuler</button>
									</div>
								}
								if port.Live {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green dark:bg-green-950 dark:text-green-300">
										<span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
										En ligne
									</span>
								}
							</li>
						}
					</ul>
				}
				<div class="flex flex-col gap-4">
					<form class="flex flex-wrap items-end gap-2" method="post" action={ "/projects/" + data.Slug + "/ports/replace" }>
						<input type="hidden" name="next" value={ "/projects/" + data.Slug + "#ports" }/>
						<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
							Nouveau port principal
							<input class="mt-1 block w-28 px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-mono font-normal dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="port" type="number" min="3000" max="9999" placeholder="auto"/>
						</label>
						<label class="flex items-center gap-1.5 text-sm font-normal text-slate-700 pb-2 dark:text-slate-300">
							<input type="checkbox" name="release_old" value="on" checked/>
							Libérer l'ancien principal
						</label>
						<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-navy hover:opacity-90 text-white text-sm font-bold rounded-lg transition-opacity cursor-pointer" type="submit">Remplacer le principal</button>
					</form>
					<div class="flex flex-wrap gap-4">
						<form class="flex flex-wrap items-end gap-2" method="post" action={ "/projects/" + data.Slug + "/ports/allocate" }>
							<input type="hidden" name="next" value={ "/projects/" + data.Slug + "#ports" }/>
							<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
								Ports supplémentaires
								<input class="mt-1 block w-24 px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="count" type="number" min="1" max="5" value="1"/>
							</label>
							<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-slate-600 dark:text-slate-200" type="submit">Attribuer</button>
						</form>
						<form class="flex flex-wrap items-end gap-2" method="post" action={ "/projects/" + data.Slug + "/ports/claim" }>
							<input type="hidden" name="next" value={ "/projects/" + data.Slug + "#ports" }/>
							<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
								Port précis
								<input class="mt-1 block w-28 px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-mono font-normal dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="port" type="number" min="3000" max="9999" placeholder="3000"/>
							</label>
							<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-slate-600 dark:text-slate-200" type="submit">Réclamer</button>
						</form>
					</div>
				</div>
			</div>
		</section>
		<section class="panel detail-panel">
			<div class="panel-head">
				<div>
					<h2>Contrôles de santé</h2>
					<p>Points de terminaison sondés. Stockés uniquement pour l'instant.</p>
				</div>
			</div>
			<div class="panel-body panel-body-padded">
				if data.HealthError != "" {
					<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
						{ data.HealthError }
					</div>
				}
				if len(data.Healthchecks) == 0 {
					<p class="text-sm text-brand-muted mb-4">Aucun point de terminaison.</p>
				} else {
					<ul class="flex flex-col gap-2 mb-4">
						for _, check := range data.Healthchecks {
							<li class="flex flex-wrap items-center gap-2">
								<code class="hub-code">{ check.Endpoint }</code>
								<span class="port">→ { check.Expected }</span>
								<form method="post" action={ "/projects/" + data.Slug + "/healthchecks/" + check.ID + "/delete" }>
									<input type="hidden" name="next" value={ "/projects/" + data.Slug }/>
									<button class="table-action" type="submit">Retirer</button>
								</form>
							</li>
						}
					</ul>
				}
				<form class="flex flex-wrap items-end gap-2" method="post" action={ "/projects/" + data.Slug + "/healthchecks" }>
					<input type="hidden" name="next" value={ "/projects/" + data.Slug }/>
					<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
						Point de terminaison
						<input class="mt-1 block w-64 max-w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-mono font-normal dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="endpoint" maxlength="2048" placeholder="/health"/>
					</label>
					<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
						Attendu
						<input class="mt-1 block w-24 px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="expected_status" type="number" min="200" max="599" placeholder="200"/>
					</label>
					<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-slate-600 dark:text-slate-200" type="submit">Ajouter</button>
				</form>
			</div>
		</section>
		<section class="panel detail-panel tracking-panel">
			<div class="panel-head"><h2>Suivi du projet</h2></div>
			<div class="tracking-card-body">
				<div class="tracking-topline">
					<span class={ "state-pill " + data.LifecycleClass }>{ data.LifecycleLabel }</span>
					<strong>{ data.LifecyclePhase }</strong>
				</div>
				<div class="tracking-meta">
					<div>
						<span>Dernière mise à jour</span>
						<strong>{ data.UpdatedAt }</strong>
					</div>
					<div>
						<span>Intention d'exécution</span>
						<strong>{ data.RuntimeIntent }</strong>
					</div>
				</div>
			</div>
		</section>
		<section class="panel detail-panel">
			<div class="panel-head"><h2>Comment exécuter ce projet</h2></div>
			<div class="panel-body panel-body-padded">
				<ol class="flex flex-col gap-4 list-decimal ml-5 marker:font-bold marker:text-brand-navy dark:marker:text-slate-300">
					<li>
						<strong>Travaillez dans votre dossier.</strong>
						<span class="text-brand-muted">Tous les fichiers se trouvent dans <code class="hub-code">{ data.Directory }</code>.</span>
					</li>
					<li>
						<strong>Écoutez votre port principal.</strong>
						if data.MainPort != "—" {
							<span class="text-brand-muted">Écoutez sur <code class="hub-code">localhost:{ data.MainPort }</code>. Ports attribués uniquement — ne prenez jamais celui d'un autre projet.</span>
						} else {
							<span class="text-brand-muted">Écoutez sur votre port principal (voir Ports ci-dessus). Ports attribués uniquement — ne prenez jamais celui d'un autre projet.</span>
						}
					</li>
					<li>
						<strong>Démarrez-le.</strong>
						<span class="text-brand-muted">Exécutez <code class="hub-code">{ data.StartupCommand }</code>. Basculez « Doit tourner » sur la page Modifier pour arrêter ou redémarrer.</span>
					</li>
					<li>
						<strong>Lisez d'abord le README.</strong>
						<span class="text-brand-muted">Il liste vos ports et votre URL.</span>
					</li>
				</ol>
			</div>
		</section>
		<section class="panel detail-panel" x-data="{ confirmArchive: false }">
			<div class="panel-head"><h2>Configuration du projet</h2></div>
			<dl class="hub-dl setup">
				<div>
					<dt>Dossier</dt>
					<dd><code class="hub-code">{ data.Directory }</code></dd>
				</div>
				<div>
					<dt>Point d'entrée</dt>
					<dd><code class="hub-code">{ data.StartupCommand }</code></dd>
				</div>
			</dl>
			if !data.Archived {
				<div class="archive">
					<div class="archive-label">
						<h3>Archiver le projet</h3>
						<p>Cela masque le projet de la recherche active et libère ses ports vers le pool partagé.</p>
					</div>
					<button class="link-danger" type="button" @click="confirmArchive = true" x-show="!confirmArchive">Archiver</button>
				</div>
				<div class="archive-confirm" x-show="confirmArchive" x-cloak>
					<p>Cette action masque le projet et libère ses ports. Le cycle de vie pourra être modifié depuis Modifier.</p>
					<div class="archive-confirm-actions">
						<button class="button secondary" type="button" @click="confirmArchive = false">Annuler</button>
						<form method="post" action={ "/projects/" + data.Slug + "/archive" }>
							<button class="button danger" type="submit">Confirmer l'archivage</button>
						</form>
					</div>
				</div>
			} else {
				<div class="archive">
					<div class="archive-label">
						<h3>Archivé</h3>
						<p>Ce projet est archivé.</p>
					</div>
				</div>
			}
		</section>
	</div>
}

templ projectFormBody(data ProjectFormData) {
	if data.IsNew {
		<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3 dark:text-blue-400" href="/projects">← Projets</a>
	} else {
		<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3 dark:text-blue-400" href={ "/projects/" + data.Slug }>← { data.Name }</a>
	}
	<h1 class="text-2xl font-bold text-brand-navy mb-4 dark:text-white">{ data.Title }</h1>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4 dark:bg-slate-800 dark:border-slate-700" method="post" action={ data.Action } x-data="{ busy: false, shouldRun: true }" x-init={ "shouldRun = " + activeJS(data.ShouldRun) } @submit="busy = true">
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			Nom
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="name" required minlength="2" maxlength="80" value={ data.Name }/>
		</label>
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			Slug
			if data.IsNew {
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="slug" pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$" value={ data.Slug } placeholder="Dérivé du nom si vide"/>
			} else {
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md bg-slate-50 text-slate-600 font-normal dark:bg-slate-900 dark:border-slate-600 dark:text-slate-400" name="slug" value={ data.Slug } readonly/>
			}
		</label>
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			Description
			<textarea class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors min-h-[96px] dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="description" maxlength="4000">{ data.Description }</textarea>
		</label>
		<fieldset class="block">
			<legend class="text-sm font-bold text-slate-700 mb-2 dark:text-slate-300">Stagiaires assignés</legend>
			if len(data.Interns) == 0 {
				<p class="text-sm text-brand-muted">Aucun stagiaire actif disponible. Créez d'abord un stagiaire.</p>
			} else {
				<div class="space-y-2 max-h-48 overflow-y-auto border border-slate-200 rounded-md p-3 dark:border-slate-600">
					for _, intern := range data.Interns {
						<label class="flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-300">
							<input class="rounded border-slate-300 text-brand-blue focus:ring-brand-blue/20" type="checkbox" name="intern_ids" value={ intern.ID } checked?={ intern.Selected }/>
							{ intern.FullName }
						</label>
					}
				</div>
			}
		</fieldset>
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			Cycle de vie
			<select name="lifecycle_status" class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200">
				<option value="draft" selected?={ data.LifecycleStatus == "" || data.LifecycleStatus == "draft" }>Brouillon</option>
				<option value="ready" selected?={ data.LifecycleStatus == "ready" }>Prêt</option>
				<option value="running" selected?={ data.LifecycleStatus == "running" }>En cours</option>
				<option value="stopped" selected?={ data.LifecycleStatus == "stopped" }>Arrêté</option>
				<option value="failed" selected?={ data.LifecycleStatus == "failed" }>Échoué</option>
				<option value="archived" selected?={ data.LifecycleStatus == "archived" }>Archivé</option>
			</select>
		</label>
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			Mode d'accès
			<select name="access_mode" class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200">
				<option value="direct" selected?={ data.AccessMode == "" || data.AccessMode == "direct" }>Direct — serveur et port principal</option>
				<option value="proxied" selected?={ data.AccessMode == "proxied" } disabled?={ !data.ProxyAvailable }>Via proxy — URL de projet partagée</option>
			</select>
			if data.ProxyAvailable {
				<span class="mt-1 block text-xs text-brand-muted">Direct est le choix par défaut, le plus compatible. Le mode proxy peut exiger un chemin de base.</span>
			} else {
				<span class="mt-1 block text-xs text-brand-muted" role="status">Proxy indisponible (Caddy ne répond pas) — seul le mode direct peut être enregistré pour l'instant.</span>
			}
		</label>
		if data.IsNew {
			<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
				Ports nécessaires
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="ports_needed" type="number" min="1" max="5" value={ strconv.Itoa(portCountOrDefault(data.PortCount)) }/>
			</label>
		}
		<div class="flex flex-wrap items-center gap-3">
			<input type="hidden" name="should_run" :value="shouldRun ? 'true' : 'false'"/>
			<button
				type="button"
				@click="shouldRun = !shouldRun"
				:class="shouldRun ? 'bg-brand-green-soft hover:bg-green-100 border-green-300 text-brand-green dark:bg-green-950 dark:hover:bg-green-900 dark:border-green-800 dark:text-green-300' : 'bg-slate-50 hover:bg-slate-100 border-slate-300 text-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-slate-600 dark:text-slate-200'"
				class="inline-flex items-center gap-1.5 justify-center min-h-[36px] px-4 py-2 border text-sm font-bold rounded-lg transition-colors cursor-pointer"
			>
				<span class="w-1.5 h-1.5 rounded-full" :class="shouldRun ? 'bg-brand-green' : 'bg-slate-400'"></span>
				<span x-text="shouldRun ? 'Doit tourner : oui' : 'Doit tourner : non'"></span>
			</button>
			if !data.IsNew {
				if data.IsLive {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green dark:bg-green-950 dark:text-green-300">Observé : en ligne</span>
				} else {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">Observé : hors ligne</span>
				}
			}
		</div>
		<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">
			if data.IsNew {
				Créer le projet
			} else {
				Enregistrer le projet
			}
		</button>
	</form>
	if !data.IsNew {
		@projectPortsPanel(data)
	}
}

templ projectPortsPanel(data ProjectFormData) {
	<section class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm mt-6 dark:bg-slate-800 dark:border-slate-700">
		<h2 class="text-base font-bold text-brand-navy dark:text-white">Ports</h2>
		<p class="text-brand-muted text-sm mt-0.5">Gérez les ports sur la <a class="table-action" href={ "/projects/" + data.Slug + "#ports" }>page du projet</a> — attribuez, réclamez, promouvez, libérez ou remplacez le principal au même endroit.</p>
		if data.PortError != "" {
			<div class="p-3 mt-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
				{ data.PortError }
			</div>
		}
	</section>
}

templ InternFormPage(data InternFormData) {
	@layouts.Shell(data.Title, data.Path, internFormBody(data))
}

templ internFormBody(data InternFormData) {
	<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3 dark:text-blue-400" href="/interns">← Stagiaires</a>
	<h1 class="text-2xl font-bold text-brand-navy mb-4 dark:text-white">{ data.Title }</h1>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4 dark:bg-slate-800 dark:border-slate-700" method="post" action={ data.Action } x-data="{ busy: false, active: true }" x-init={ "active = " + activeJS(data.Active) } @submit="busy = true">
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			Nom complet
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="full_name" required value={ data.FullName }/>
		</label>
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			Nom d'utilisateur
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" name="identifier" required value={ data.Identifier }/>
		</label>
		<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
			E-mail
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors dark:bg-slate-900 dark:border-slate-600 dark:text-slate-200" type="email" name="email" value={ data.Email }/>
		</label>
		if data.IsNew {
			<label class="block text-sm font-bold text-slate-700 dark:text-slate-300">
				Mot de passe
				@components.PasswordField("password", "new-password", true)
			</label>
			<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Enregistrer le stagiaire</button>
		} else {
			<div class="flex flex-wrap items-center gap-3">
				<input type="hidden" name="active" :value="active ? 'true' : 'false'"/>
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Enregistrer le stagiaire</button>
				<button
					type="button"
					@click="active = !active"
					:class="active ? 'bg-red-50 hover:bg-red-100 border-red-300 text-brand-red' : 'bg-green-50 hover:bg-green-100 border-green-300 text-brand-green'"
					class="inline-flex items-center gap-1.5 justify-center min-h-[36px] px-4 py-2 border text-sm font-bold rounded-lg transition-colors cursor-pointer"
				>
					<span class="w-1.5 h-1.5 rounded-full" :class="active ? 'bg-brand-red' : 'bg-brand-green'"></span>
					<span x-text="active ? 'Désactiver le compte' : 'Activer le compte'"></span>
				</button>
			</div>
		}
	</form>
}
