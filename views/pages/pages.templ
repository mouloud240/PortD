package pages

import (
	"github.com/portd/views/components"
	"github.com/portd/views/layouts"
)

templ DashboardPage() {
	@layouts.Shell("Overview", "/dashboard", dashboardBody())
}

templ dashboardBody() {
	<div class="space-y-1">
		<h1 class="text-2xl font-bold text-brand-navy">Overview</h1>
		<p class="text-brand-muted text-sm">Project overview will appear here.</p>
	</div>
}

templ PlaceholderPage(title string, path string) {
	@layouts.Shell(title, path, placeholderBody(title))
}

templ placeholderBody(title string) {
	<div class="space-y-1">
		<h1 class="text-2xl font-bold text-brand-navy">{ title }</h1>
		<p class="text-brand-muted text-sm">This page is ready for its feature.</p>
	</div>
}

templ LoginPage(errorMessage string) {
	<!doctype html>
	<html lang="en" class="h-full bg-brand-ground">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in · PortD</title>
			<link rel="stylesheet" href="/static/app.css"/>
			@layouts.HeadScripts()
		</head>
		<body class="min-h-full font-sans text-sm text-brand-ink antialiased bg-brand-ground flex items-center justify-center p-4">
			<main class="w-full max-w-sm bg-white border border-brand-line rounded-lg p-6 shadow-sm">
				<h1 class="text-2xl font-bold text-brand-navy">PortD</h1>
				<p class="text-brand-muted text-sm mt-0.5 mb-5">Signing in to manage internship projects.</p>
				if errorMessage != "" {
					<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
						{ errorMessage }
					</div>
				}
				<form method="post" action="/login" class="space-y-4">
					<label class="block text-sm font-bold text-slate-700">
						Username
						<input
							name="username"
							required
							autocomplete="username"
							class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors"
						/>
					</label>
					<label class="block text-sm font-bold text-slate-700">
						Password
						@components.PasswordField("password", "current-password", true)
					</label>
					<button
						type="submit"
						class="w-full mt-2 inline-flex items-center justify-center min-h-[38px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover text-white text-sm font-bold rounded-lg transition-colors cursor-pointer shadow-sm"
					>
						Sign in
					</button>
				</form>
			</main>
		</body>
	</html>
}

templ ProfilePage(data ProfileData) {
	@layouts.Shell(data.Title, data.Path, profileBody(data))
}

templ profileBody(data ProfileData) {
	<div class="space-y-1 mb-6">
		<h1 class="text-2xl font-bold text-brand-navy">Profile</h1>
		<p class="text-brand-muted text-sm">Signed in as <strong>{ data.Role }</strong>.</p>
	</div>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	if data.IsAdmin {
		<section class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4">
			<dl class="space-y-3">
				<div>
					<dt class="text-xs font-bold text-slate-500 uppercase tracking-wider">Username</dt>
					<dd class="mt-0.5 text-sm font-bold text-brand-navy">{ data.Username }</dd>
				</div>
				<div>
					<dt class="text-xs font-bold text-slate-500 uppercase tracking-wider">Role</dt>
					<dd class="mt-0.5 text-sm text-slate-700">{ data.Role }</dd>
				</div>
			</dl>
			<p class="text-xs text-slate-400">The admin account is managed via server configuration.</p>
			<form method="post" action="/logout">
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer">Sign out</button>
			</form>
		</section>
	} else {
		<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4" method="post" action="/profile" x-data="{ busy: false }" @submit="busy = true">
			<label class="block text-sm font-bold text-slate-700">
				Full name
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="full_name" required value={ data.FullName }/>
			</label>
			<label class="block text-sm font-bold text-slate-700">
				Username
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="identifier" required value={ data.Username }/>
			</label>
			<label class="block text-sm font-bold text-slate-700">
				Email
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" type="email" name="email" value={ data.Email }/>
			</label>
			<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Save changes</button>
		</form>
		<section class="max-w-xl mt-4 bg-white border border-brand-line rounded-lg p-6 shadow-sm">
			<form method="post" action="/logout">
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer">Sign out</button>
			</form>
		</section>
	}
}

templ InternsPage(title string, path string, search string, state string, items []InternListItem) {
	@layouts.Shell(title, path, internsBody(search, state, items))
}

templ internsBody(search string, state string, items []InternListItem) {
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
		<div>
			<h1 class="text-2xl font-bold text-brand-navy">Interns</h1>
			<p class="text-brand-muted text-sm mt-0.5">Create intern accounts and see the projects they own.</p>
		</div>
		<a class="inline-flex items-center justify-center min-h-[36px] px-3.5 py-2 bg-brand-blue hover:bg-brand-blue-hover text-white text-sm font-bold rounded-lg transition-colors shadow-sm cursor-pointer" href="/interns/new">+ Add intern</a>
	</div>
	<section class="bg-white border border-brand-line rounded-lg shadow-sm overflow-hidden">
		<form class="flex flex-wrap items-center gap-3 p-4 border-b border-brand-line" method="get" x-target="intern-table">
			<input class="w-full max-w-md flex-1 min-w-[200px] px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 placeholder-slate-400 font-normal transition-colors" name="q" value={ search } placeholder="Search interns" aria-label="Search interns"/>
			<select name="state" aria-label="Filter by activity state" onchange="this.form.requestSubmit()" class="px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer">
				<option value="all" selected?={ state == "" || state == "all" }>All states</option>
				<option value="active" selected?={ state == "active" }>Active</option>
				<option value="inactive" selected?={ state == "inactive" }>Inactive</option>
			</select>
			<button class="inline-flex items-center justify-center min-h-[36px] px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer">Search</button>
		</form>
		<div id="intern-table" class="overflow-x-auto">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="border-b border-brand-line bg-slate-50/75">
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">Name</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">Username</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">Email</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">State</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					for _, item := range items {
						<tr class="hover:bg-slate-50/60 transition-colors">
							<td class="px-5 py-3.5 text-sm font-bold text-brand-navy whitespace-nowrap">
								<a class="text-brand-blue hover:underline" href={ "/interns/" + item.ID }>{ item.FullName }</a>
							</td>
							<td class="px-5 py-3.5 text-sm whitespace-nowrap">
								<code class="font-mono text-xs px-2 py-0.5 bg-slate-100 border border-slate-200 rounded text-slate-700">{ item.Username }</code>
							</td>
							<td class="px-5 py-3.5 text-sm text-slate-600 whitespace-nowrap">{ item.Email }</td>
							<td class="px-5 py-3.5 text-sm whitespace-nowrap">
								if item.Active {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green">
										<span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
										Active
									</span>
								} else {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600">
										<span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
										Inactive
									</span>
								}
							</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan="4" class="px-5 py-12 text-center text-brand-muted text-sm">No interns found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ ProjectsPage(title string, path string, search string, lifecycle string, live string, items []ProjectListItem) {
	@layouts.Shell(title, path, projectsBody(search, lifecycle, live, items))
}

templ projectsBody(search string, lifecycle string, live string, items []ProjectListItem) {
	<div class="page-heading">
		<div>
			<h1>Projects</h1>
			<p>Search the central registry and open an available internal URL.</p>
		</div>
		<a class="button primary" href="/projects/new">+ Add project</a>
	</div>
	<section class="panel">
		<form class="toolbar" method="get" x-target="project-table">
			<input name="q" value={ search } type="search" placeholder="Search projects, owners, or ports" aria-label="Search projects"/>
			<select name="lifecycle_status" aria-label="Filter by lifecycle" onchange="this.form.requestSubmit()">
				<option value="" selected?={ lifecycle == "" }>All lifecycles</option>
				<option value="draft" selected?={ lifecycle == "draft" }>Draft</option>
				<option value="ready" selected?={ lifecycle == "ready" }>Ready</option>
				<option value="running" selected?={ lifecycle == "running" }>Running</option>
				<option value="stopped" selected?={ lifecycle == "stopped" }>Stopped</option>
				<option value="failed" selected?={ lifecycle == "failed" }>Failed</option>
				<option value="archived" selected?={ lifecycle == "archived" }>Archived</option>
			</select>
			<select name="is_live" aria-label="Filter by live state" onchange="this.form.requestSubmit()">
				<option value="" selected?={ live == "" }>All statuses</option>
				<option value="true" selected?={ live == "true" }>Running</option>
				<option value="false" selected?={ live == "false" }>Down</option>
			</select>
			<button class="button secondary" type="submit">Search</button>
		</form>
		<div class="panel-body table-wrap" id="project-table">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Project</th>
						<th>Intern</th>
						<th>Status</th>
						<th>Main port</th>
						<th>Tracking</th>
						<th>Internal URL</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, item := range items {
						<tr>
							<td>
								<a class="project-name" href={ "/projects/" + item.Slug }>{ item.Name }</a>
							</td>
							<td>{ item.Interns }</td>
							<td>
								<span class={ "badge " + item.StatusClass }>{ item.StatusLabel }</span>
							</td>
							<td>
								<code class="hub-code">{ item.MainPort }</code>
							</td>
							<td>
								<span class={ "state-pill " + item.LifecycleClass }>{ item.LifecycleLabel }</span>
							</td>
							<td>
								<a class="table-action" href={ item.URL } target="_blank" rel="noreferrer">{ item.URLLabel } ↗</a>
							</td>
							<td>
								<a class="table-action" href={ "/projects/" + item.Slug }>View</a>
							</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan="7">
								<div class="empty-state">No projects match your search.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ ProjectFormPage(data ProjectFormData) {
	@layouts.Shell(data.Title, data.Path, projectFormBody(data))
}

templ ProjectDetailPage(data ProjectDetailData) {
	@layouts.Shell(data.Name, data.Path, projectDetailBody(data))
}

templ projectDetailBody(data ProjectDetailData) {
	<a class="breadcrumb" href="/projects">Projects / <span>{ data.Name }</span></a>
	<div class="project-hero">
		<div>
			<div class="title-row">
				<h1>{ data.Name }</h1>
				<span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span>
			</div>
			<a href={ data.URL } target="_blank" rel="noreferrer">{ data.URLLabel } ↗</a>
			if data.Description != "" {
				<p>{ data.Description }</p>
			}
		</div>
		<div class="project-hero-actions">
			<a class="button secondary" href={ "/projects/" + data.Slug + "/edit" }>Edit</a>
			<a class="button primary" href={ data.URL } target="_blank" rel="noreferrer">Open project ↗</a>
		</div>
	</div>
	<div class="detail-grid">
		<section class="panel">
			<div class="panel-head"><h2>Project details</h2></div>
			<dl class="hub-dl">
				<div>
					<dt>Owner</dt>
					<dd>{ data.Owners }</dd>
				</div>
				<div>
					<dt>Created</dt>
					<dd>{ data.CreatedAt }</dd>
				</div>
				<div>
					<dt>Last updated</dt>
					<dd>{ data.UpdatedAt }</dd>
				</div>
			</dl>
		</section>
		<section class="panel">
			<div class="panel-head"><h2>Deployment configuration</h2></div>
			<dl class="hub-dl four-up">
				<div>
					<dt>Host server</dt>
					<dd>—</dd>
				</div>
				<div>
					<dt>Main port</dt>
					<dd><code class="hub-code">{ data.MainPort }</code></dd>
				</div>
				<div>
					<dt>Protocol</dt>
					<dd>HTTP</dd>
				</div>
				<div>
					<dt>Reachability</dt>
					<dd><span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span></dd>
				</div>
			</dl>
		</section>
	</div>
	<section class="panel tracking-panel">
		<div class="panel-head"><h2>Project tracking</h2></div>
		<div class="tracking-card-body">
			<div class="tracking-topline">
				<span class={ "state-pill " + data.LifecycleClass }>{ data.LifecycleLabel }</span>
				<strong>{ data.LifecyclePhase }</strong>
			</div>
			<div class="tracking-meta">
				<div>
					<span>Last update</span>
					<strong>{ data.UpdatedAt }</strong>
				</div>
				<div>
					<span>Runtime intent</span>
					<strong>{ data.RuntimeIntent }</strong>
				</div>
			</div>
		</div>
	</section>
	<section class="panel" x-data="{ confirmArchive: false }">
		<div class="panel-head"><h2>Project setup</h2></div>
		<dl class="hub-dl setup">
			<div>
				<dt>Directory</dt>
				<dd><code class="hub-code">{ data.Directory }</code></dd>
			</div>
			<div>
				<dt>Entry point</dt>
				<dd><code class="hub-code">{ data.StartupCommand }</code></dd>
			</div>
			<div>
				<dt>Allocated ports</dt>
				<dd><span class="port main">{ data.MainPort } main</span></dd>
			</div>
		</dl>
		if !data.Archived {
			<div class="archive">
				<div class="archive-label">
					<h3>Archive project</h3>
					<p>This hides the project from active discovery and frees its assigned ports to the shared pool.</p>
				</div>
				<button class="link-danger" type="button" @click="confirmArchive = true" x-show="!confirmArchive">Archive</button>
			</div>
			<div class="archive-confirm" x-show="confirmArchive" x-cloak>
				<p>This action hides the project and frees its ports. Lifecycle can be changed later from Edit.</p>
				<div class="archive-confirm-actions">
					<button class="button secondary" type="button" @click="confirmArchive = false">Cancel</button>
					<form method="post" action={ "/projects/" + data.Slug + "/archive" }>
						<button class="button danger" type="submit">Confirm archive</button>
					</form>
				</div>
			</div>
		} else {
			<div class="archive">
				<div class="archive-label">
					<h3>Archived</h3>
					<p>This project is archived.</p>
				</div>
			</div>
		}
	</section>
}

templ projectFormBody(data ProjectFormData) {
	if data.IsNew {
		<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3" href="/projects">← Projects</a>
	} else {
		<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3" href={ "/projects/" + data.Slug }>← { data.Name }</a>
	}
	<h1 class="text-2xl font-bold text-brand-navy mb-4">{ data.Title }</h1>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4" method="post" action={ data.Action } x-data="{ busy: false, shouldRun: true }" x-init={ "shouldRun = " + activeJS(data.ShouldRun) } @submit="busy = true">
		<label class="block text-sm font-bold text-slate-700">
			Name
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="name" required minlength="2" maxlength="80" value={ data.Name }/>
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Slug
			if data.IsNew {
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="slug" pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$" value={ data.Slug } placeholder="Derived from name when empty"/>
			} else {
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md bg-slate-50 text-slate-600 font-normal" name="slug" value={ data.Slug } readonly/>
			}
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Description
			<textarea class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors min-h-[96px]" name="description" maxlength="4000">{ data.Description }</textarea>
		</label>
		<fieldset class="block">
			<legend class="text-sm font-bold text-slate-700 mb-2">Assigned interns</legend>
			if len(data.Interns) == 0 {
				<p class="text-sm text-brand-muted">No active interns available. Create an intern first.</p>
			} else {
				<div class="space-y-2 max-h-48 overflow-y-auto border border-slate-200 rounded-md p-3">
					for _, intern := range data.Interns {
						<label class="flex items-center gap-2 text-sm font-medium text-slate-700">
							<input class="rounded border-slate-300 text-brand-blue focus:ring-brand-blue/20" type="checkbox" name="intern_ids" value={ intern.ID } checked?={ intern.Selected }/>
							{ intern.FullName }
						</label>
					}
				</div>
			}
		</fieldset>
		<label class="block text-sm font-bold text-slate-700">
			Lifecycle
			<select name="lifecycle_status" class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer">
				<option value="draft" selected?={ data.LifecycleStatus == "" || data.LifecycleStatus == "draft" }>Draft</option>
				<option value="ready" selected?={ data.LifecycleStatus == "ready" }>Ready</option>
				<option value="running" selected?={ data.LifecycleStatus == "running" }>Running</option>
				<option value="stopped" selected?={ data.LifecycleStatus == "stopped" }>Stopped</option>
				<option value="failed" selected?={ data.LifecycleStatus == "failed" }>Failed</option>
				<option value="archived" selected?={ data.LifecycleStatus == "archived" }>Archived</option>
			</select>
		</label>
		<div class="flex flex-wrap items-center gap-3">
			<input type="hidden" name="should_run" :value="shouldRun ? 'true' : 'false'"/>
			<button
				type="button"
				@click="shouldRun = !shouldRun"
				:class="shouldRun ? 'bg-brand-green-soft hover:bg-green-100 border-green-300 text-brand-green' : 'bg-slate-50 hover:bg-slate-100 border-slate-300 text-slate-700'"
				class="inline-flex items-center gap-1.5 justify-center min-h-[36px] px-4 py-2 border text-sm font-bold rounded-lg transition-colors cursor-pointer"
			>
				<span class="w-1.5 h-1.5 rounded-full" :class="shouldRun ? 'bg-brand-green' : 'bg-slate-400'"></span>
				<span x-text="shouldRun ? 'Should run: on' : 'Should run: off'"></span>
			</button>
			if !data.IsNew {
				if data.IsLive {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green">Observed: live</span>
				} else {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600">Observed: not live</span>
				}
			}
		</div>
		<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">
			if data.IsNew {
				Create project
			} else {
				Save project
			}
		</button>
	</form>
}

templ InternFormPage(data InternFormData) {
	@layouts.Shell(data.Title, data.Path, internFormBody(data))
}

templ internFormBody(data InternFormData) {
	<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3" href="/interns">← Interns</a>
	<h1 class="text-2xl font-bold text-brand-navy mb-4">{ data.Title }</h1>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4" method="post" action={ data.Action } x-data="{ busy: false, active: true }" x-init={ "active = " + activeJS(data.Active) } @submit="busy = true">
		<label class="block text-sm font-bold text-slate-700">
			Full name
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="full_name" required value={ data.FullName }/>
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Username
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="identifier" required value={ data.Identifier }/>
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Email
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" type="email" name="email" value={ data.Email }/>
		</label>
		if data.IsNew {
			<label class="block text-sm font-bold text-slate-700">
				Password
				@components.PasswordField("password", "new-password", true)
			</label>
			<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Save intern</button>
	} else {
		<div class="flex flex-wrap items-center gap-3">
			<input type="hidden" name="active" :value="active ? 'true' : 'false'"/>
			<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Save intern</button>
			<button
				type="button"
				@click="active = !active"
				:class="active ? 'bg-red-50 hover:bg-red-100 border-red-300 text-brand-red' : 'bg-green-50 hover:bg-green-100 border-green-300 text-brand-green'"
				class="inline-flex items-center gap-1.5 justify-center min-h-[36px] px-4 py-2 border text-sm font-bold rounded-lg transition-colors cursor-pointer"
			>
				<span class="w-1.5 h-1.5 rounded-full" :class="active ? 'bg-brand-red' : 'bg-brand-green'"></span>
				<span x-text="active ? 'Deactivate account' : 'Activate account'"></span>
			</button>
		</div>
	}
	</form>
}
