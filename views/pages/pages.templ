package pages

import (
	"strconv"

	"github.com/portd/views/components"
	"github.com/portd/views/layouts"
)

templ DashboardPage(data DashboardData) {
	@layouts.Shell("Overview", "/dashboard", dashboardBody(data))
}

templ dashboardBody(data DashboardData) {
	<div class="page-heading">
		<div>
			<h1>Overview</h1>
			<p>Monitor intern projects and assigned server ports.</p>
		</div>
		<a class="button primary" href="/projects/new">+ Add project</a>
	</div>
	<div class="stat-grid">
		<article><span>Active projects</span><strong>{ strconv.Itoa(data.ActiveProjects) }</strong><small>Non-archived</small></article>
		<article><span>Running services</span><strong>{ strconv.Itoa(data.LiveServices) }<em>/{ strconv.Itoa(data.TotalServices) }</em></strong><small>Reachability snapshot</small></article>
		<article>
			<span>Used ports</span><strong>{ strconv.Itoa(data.AssignedPorts) }</strong>
			if data.UnknownPorts > 0 {
				<small class="warning">{ strconv.Itoa(data.UnknownPorts) } unknown</small>
			} else {
				<small>All registered</small>
			}
		</article>
		<article><span>Active interns</span><strong>{ strconv.Itoa(data.ActiveInterns) }</strong><small>Current placements</small></article>
	</div>
	<section class="panel">
		<div class="panel-head">
			<div>
				<h2>Projects by lifecycle</h2>
				<p>Active projects per stage, excluding archived.</p>
			</div>
			<a class="table-action" href="/projects">View all</a>
		</div>
		<div class="panel-body panel-body-padded">
			<ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
				for _, bar := range data.Lifecycle {
					<li style="display:flex;align-items:center;gap:12px;">
						<span class={ "state-pill " + bar.Class } style="min-width:88px;">{ bar.Label }</span>
						<span style="flex:1;height:10px;border-radius:999px;background:#eef2f6;overflow:hidden;" role="presentation">
							<span style={ "display:block;height:100%;border-radius:999px;background:" + bar.Color + ";width:" + strconv.Itoa(bar.Percent) + "%;" }></span>
						</span>
						<strong style="min-width:24px;text-align:right;">{ strconv.Itoa(bar.Count) }</strong>
					</li>
				}
			</ul>
		</div>
	</section>
	<div class="two-column">
		<section class="panel">
			<div class="panel-head">
				<div>
					<h2>Current projects</h2>
					<p>Open an internal project or view its setup.</p>
				</div>
				<a class="table-action" href="/projects">View all</a>
			</div>
			<div class="panel-body table-wrap">
				<table class="hub-table">
					<thead>
						<tr>
							<th>Project</th>
							<th>Status</th>
							<th>Main port</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, item := range data.Projects {
							<tr>
								<td><a class="project-name" href={ "/projects/" + item.Slug }>{ item.Name }</a></td>
								<td><span class={ "badge " + item.StatusClass }>{ item.StatusLabel }</span></td>
								<td><code class="hub-code">{ item.MainPort }</code></td>
								<td><a class="table-action" href={ "/projects/" + item.Slug }>View</a></td>
							</tr>
						}
						if len(data.Projects) == 0 {
							<tr>
								<td colspan="4">
									<div class="empty-state">No active projects yet.</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<section class="panel activity">
			<div class="panel-head">
				<div>
					<h2>Recent activity</h2>
				</div>
				<a class="table-action" href="/activity">View all</a>
			</div>
			<ol>
				for _, item := range data.Recent {
					<li class={ activityLiClass(item.Failed) }>
						<time>{ item.Time }</time>
						<span>
							<b>{ item.EventLabel }</b> { item.Entity }
							if item.Detail != "" {
								{ " — " + item.Detail }
							}
						</span>
					</li>
				}
				if len(data.Recent) == 0 {
					<li><span>No activity recorded yet.</span></li>
				}
			</ol>
		</section>
	</div>
}

templ PlaceholderPage(title string, path string) {
	@layouts.Shell(title, path, placeholderBody(title))
}

templ ActivityPage(data ActivityData) {
	@layouts.Shell(data.Title, data.Path, activityBody(data))
}

templ activityBody(data ActivityData) {
	<div class="page-heading">
		<div>
			<h1>Activity</h1>
			<p>Audit trail of project, runtime, port, intern, and session events.</p>
		</div>
	</div>
	<section class="panel">
		<form class="toolbar" method="get">
			<input name="q" value={ data.Search } type="search" placeholder="Search entity or detail" aria-label="Search activity"/>
			<select name="category" aria-label="Filter by category" onchange="this.form.requestSubmit()">
				<option value="" selected?={ data.Category == "" }>All categories</option>
				for _, category := range data.Categories {
					<option value={ category } selected?={ data.Category == category }>{ CategoryName(category) }</option>
				}
			</select>
			<select name="event_type" aria-label="Filter by event" onchange="this.form.requestSubmit()">
				<option value="" selected?={ data.EventType == "" }>All events</option>
				for _, event := range data.EventTypes {
					<option value={ event } selected?={ data.EventType == event }>{ event }</option>
				}
			</select>
			<select name="outcome" aria-label="Filter by outcome" onchange="this.form.requestSubmit()">
				<option value="" selected?={ data.Outcome == "" }>All outcomes</option>
				<option value="success" selected?={ data.Outcome == "success" }>Success</option>
				<option value="failure" selected?={ data.Outcome == "failure" }>Failure</option>
			</select>
			<button class="button secondary" type="submit">Search</button>
		</form>
		<div class="panel-body table-wrap">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Time</th>
						<th>Event</th>
						<th>Entity</th>
						<th>Actor</th>
						<th>Outcome</th>
						<th>Detail</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range data.Items {
						<tr>
							<td><time>{ item.Time }</time></td>
							<td>
								<div><strong>{ item.EventLabel }</strong></div>
								<span class={ "badge " + item.CategoryClass }>{ item.Category }</span>
							</td>
							<td>{ item.Entity }</td>
							<td><code class="hub-code" title={ item.Actor }>{ item.ActorShort }</code></td>
							<td><span class={ "badge " + item.OutcomeClass }>{ item.Outcome }</span></td>
							<td>{ item.Detail }</td>
						</tr>
					}
					if len(data.Items) == 0 {
						<tr>
							<td colspan="6">
								<div class="empty-state">No activity matches these filters.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="panel-body">
			if data.HasPrev {
				<form method="get">
					<input type="hidden" name="q" value={ data.Search }/>
					<input type="hidden" name="category" value={ data.Category }/>
					<input type="hidden" name="event_type" value={ data.EventType }/>
					<input type="hidden" name="outcome" value={ data.Outcome }/>
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page - 1) }/>
					<button class="button secondary" type="submit">← Newer</button>
				</form>
			}
			if data.HasNext {
				<form method="get">
					<input type="hidden" name="q" value={ data.Search }/>
					<input type="hidden" name="category" value={ data.Category }/>
					<input type="hidden" name="event_type" value={ data.EventType }/>
					<input type="hidden" name="outcome" value={ data.Outcome }/>
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page + 1) }/>
					<button class="button secondary" type="submit">Older →</button>
				</form>
			}
		</div>
	</section>
}

templ placeholderBody(title string) {
	<div class="space-y-1">
		<h1 class="text-2xl font-bold text-brand-navy">{ title }</h1>
		<p class="text-brand-muted text-sm">This page is ready for its feature.</p>
	</div>
}

templ LoginPage(errorMessage string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-brand-ground">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in · PortD</title>
			<link rel="stylesheet" href="/static/app.css"/>
			@layouts.HeadScripts()
		</head>
		<body class="min-h-full font-sans text-sm text-brand-ink antialiased bg-brand-ground flex items-center justify-center p-4">
			<main class="w-full max-w-sm bg-white border border-brand-line rounded-lg p-6 shadow-sm">
				<h1 class="text-2xl font-bold text-brand-navy">PortD</h1>
				<p class="text-brand-muted text-sm mt-0.5 mb-5">Signing in to manage internship projects.</p>
				if errorMessage != "" {
					<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
						{ errorMessage }
					</div>
				}
				<form method="post" action="/login" class="space-y-4">
					<label class="block text-sm font-bold text-slate-700">
						Username
						<input
							name="username"
							required
							autocomplete="username"
							class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors"
						/>
					</label>
					<label class="block text-sm font-bold text-slate-700">
						Password
						@components.PasswordField("password", "current-password", true)
					</label>
					<button
						type="submit"
						class="w-full mt-2 inline-flex items-center justify-center min-h-[38px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover text-white text-sm font-bold rounded-lg transition-colors cursor-pointer shadow-sm"
					>
						Sign in
					</button>
				</form>
			</main>
		</body>
	</html>
}

templ ProfilePage(data ProfileData) {
	@layouts.Shell(data.Title, data.Path, profileBody(data))
}

templ profileBody(data ProfileData) {
	<div class="space-y-1 mb-6">
		<h1 class="text-2xl font-bold text-brand-navy">Profile</h1>
		<p class="text-brand-muted text-sm">Signed in as <strong>{ data.Role }</strong>.</p>
	</div>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	if data.IsAdmin {
		<section class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4">
			<dl class="space-y-3">
				<div>
					<dt class="text-xs font-bold text-slate-500 uppercase tracking-wider">Username</dt>
					<dd class="mt-0.5 text-sm font-bold text-brand-navy">{ data.Username }</dd>
				</div>
				<div>
					<dt class="text-xs font-bold text-slate-500 uppercase tracking-wider">Role</dt>
					<dd class="mt-0.5 text-sm text-slate-700">{ data.Role }</dd>
				</div>
			</dl>
			<p class="text-xs text-slate-400">The admin account is managed via server configuration.</p>
			<form method="post" action="/logout">
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer">Sign out</button>
			</form>
		</section>
	} else {
		<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4" method="post" action="/profile" x-data="{ busy: false }" @submit="busy = true">
			<label class="block text-sm font-bold text-slate-700">
				Full name
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="full_name" required value={ data.FullName }/>
			</label>
			<label class="block text-sm font-bold text-slate-700">
				Username
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="identifier" required value={ data.Username }/>
			</label>
			<label class="block text-sm font-bold text-slate-700">
				Email
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" type="email" name="email" value={ data.Email }/>
			</label>
			<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Save changes</button>
		</form>
		<section class="max-w-xl mt-4 bg-white border border-brand-line rounded-lg p-6 shadow-sm">
			<form method="post" action="/logout">
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer">Sign out</button>
			</form>
		</section>
	}
}

templ InternsPage(title string, path string, search string, state string, items []InternListItem) {
	@layouts.Shell(title, path, internsBody(search, state, items))
}

templ internsBody(search string, state string, items []InternListItem) {
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
		<div>
			<h1 class="text-2xl font-bold text-brand-navy">Interns</h1>
			<p class="text-brand-muted text-sm mt-0.5">Create intern accounts and see the projects they own.</p>
		</div>
		<a class="inline-flex items-center justify-center min-h-[36px] px-3.5 py-2 bg-brand-blue hover:bg-brand-blue-hover text-white text-sm font-bold rounded-lg transition-colors shadow-sm cursor-pointer" href="/interns/new">+ Add intern</a>
	</div>
	<section class="bg-white border border-brand-line rounded-lg shadow-sm overflow-hidden">
		<form class="flex flex-wrap items-center gap-3 p-4 border-b border-brand-line" method="get" x-target="intern-table">
			<input class="w-full max-w-md flex-1 min-w-[200px] px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 placeholder-slate-400 font-normal transition-colors" name="q" value={ search } placeholder="Search interns" aria-label="Search interns"/>
			<select name="state" aria-label="Filter by activity state" onchange="this.form.requestSubmit()" class="px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer">
				<option value="all" selected?={ state == "" || state == "all" }>All states</option>
				<option value="active" selected?={ state == "active" }>Active</option>
				<option value="inactive" selected?={ state == "inactive" }>Inactive</option>
			</select>
			<button class="inline-flex items-center justify-center min-h-[36px] px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer">Search</button>
		</form>
		<div id="intern-table" class="overflow-x-auto">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="border-b border-brand-line bg-slate-50/75">
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">Name</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">Username</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">Email</th>
						<th class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">State</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					for _, item := range items {
						<tr class="hover:bg-slate-50/60 transition-colors">
							<td class="px-5 py-3.5 text-sm font-bold text-brand-navy whitespace-nowrap">
								<a class="text-brand-blue hover:underline" href={ "/interns/" + item.ID }>{ item.FullName }</a>
							</td>
							<td class="px-5 py-3.5 text-sm whitespace-nowrap">
								<code class="font-mono text-xs px-2 py-0.5 bg-slate-100 border border-slate-200 rounded text-slate-700">{ item.Username }</code>
							</td>
							<td class="px-5 py-3.5 text-sm text-slate-600 whitespace-nowrap">{ item.Email }</td>
							<td class="px-5 py-3.5 text-sm whitespace-nowrap">
								if item.Active {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green">
										<span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
										Active
									</span>
								} else {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600">
										<span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
										Inactive
									</span>
								}
							</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan="4" class="px-5 py-12 text-center text-brand-muted text-sm">No interns found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ ProjectsPage(title string, path string, search string, lifecycle string, live string, items []ProjectListItem, detected []DetectItem, showDetect bool) {
	@layouts.Shell(title, path, projectsBody(search, lifecycle, live, items, detected, showDetect))
}

templ projectsBody(search string, lifecycle string, live string, items []ProjectListItem, detected []DetectItem, showDetect bool) {
	<div class="page-heading">
		<div>
			<h1>Projects</h1>
			<p>Search the central registry and open an available internal URL.</p>
		</div>
		<div>
			<a class="button secondary" href="/projects/detect">Detect from disk</a>
			<a class="button primary" href="/projects/new">+ Add project</a>
		</div>
	</div>
	<section class="panel">
		<form class="toolbar" method="get" x-target="project-table">
			<input name="q" value={ search } type="search" placeholder="Search projects, owners, or ports" aria-label="Search projects"/>
			<select name="lifecycle_status" aria-label="Filter by lifecycle" onchange="this.form.requestSubmit()">
				<option value="" selected?={ lifecycle == "" }>All lifecycles</option>
				<option value="draft" selected?={ lifecycle == "draft" }>Draft</option>
				<option value="ready" selected?={ lifecycle == "ready" }>Ready</option>
				<option value="running" selected?={ lifecycle == "running" }>Running</option>
				<option value="stopped" selected?={ lifecycle == "stopped" }>Stopped</option>
				<option value="failed" selected?={ lifecycle == "failed" }>Failed</option>
				<option value="archived" selected?={ lifecycle == "archived" }>Archived</option>
			</select>
			<select name="is_live" aria-label="Filter by live state" onchange="this.form.requestSubmit()">
				<option value="" selected?={ live == "" }>All statuses</option>
				<option value="true" selected?={ live == "true" }>Running</option>
				<option value="false" selected?={ live == "false" }>Down</option>
			</select>
			<button class="button secondary" type="submit">Search</button>
		</form>
		<div class="panel-body table-wrap" id="project-table">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Project</th>
						<th>Intern</th>
						<th>Status</th>
						<th>Main port</th>
						<th>Tracking</th>
						<th>Internal URL</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, item := range items {
						<tr>
							<td>
								<a class="project-name" href={ "/projects/" + item.Slug }>{ item.Name }</a>
							</td>
							<td>{ item.Interns }</td>
							<td>
								<span class={ "badge " + item.StatusClass }>{ item.StatusLabel }</span>
								if item.MissingStartup {
									<span class="badge warning">No startup file</span>
								}
							</td>
							<td>
								<code class="hub-code">{ item.MainPort }</code>
							</td>
							<td>
								<span class={ "state-pill " + item.LifecycleClass }>{ item.LifecycleLabel }</span>
							</td>
							<td>
								<span class="badge neutral">{ item.AccessLabel }</span>
								<a class="table-action" href={ item.URL } target="_blank" rel="noreferrer">{ item.URLLabel } ↗</a>
							</td>
							<td>
								<a class="table-action" href={ "/projects/" + item.Slug }>View</a>
							</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan="7">
								<div class="empty-state">No projects match your search.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	if showDetect {
		@detectModal(detected)
	}
}

templ detectModal(detected []DetectItem) {
	<div class="detect-overlay" x-data="{ query: '' }" @keydown.escape.window="window.location.href = '/projects'">
		<div class="detect-backdrop" aria-hidden="true" @click="window.location.href = '/projects'"></div>
		<div class="detect-dialog panel" role="dialog" aria-modal="true" aria-labelledby="detect-title">
			<div class="panel-head">
				<div>
					<h2 id="detect-title">Detected projects</h2>
					<p>Select the folders to add. Already-registered ones are greyed out.</p>
				</div>
				<a class="table-action" href="/projects" aria-label="Close">✕</a>
			</div>
			<form method="post" action="/projects/detect" x-ref="detectForm">
				<div class="detect-toolbar">
					<input
						type="search"
						name="detect-q"
						placeholder="Search folders"
						aria-label="Search detected folders"
						autofocus
						x-model="query"
					/>
					<button
						class="button secondary"
						type="button"
						@click="$refs.detectForm.querySelectorAll('input[name=slugs]:not(:disabled)').forEach(c => c.checked = true)"
					>Select all</button>
					<button
						class="button secondary"
						type="button"
						@click="$refs.detectForm.querySelectorAll('input[name=slugs]:not(:disabled)').forEach(c => c.checked = false)"
					>Unselect all</button>
				</div>
				<ul class="detect-list">
					for _, item := range detected {
						<li
							class={ "detect-row", templ.KV("is-existing", item.Exists) }
							data-search={ item.Name + " " + item.Slug }
							x-show="!query || $el.dataset.search.toLowerCase().includes(query.toLowerCase())"
						>
							<label>
								if item.Exists {
									<input type="checkbox" name="slugs" value={ item.Slug } disabled/>
								} else {
									<input type="checkbox" name="slugs" value={ item.Slug } checked/>
								}
								<span class="detect-name">{ item.Name }</span>
								<code class="hub-code">{ item.Slug }</code>
							</label>
							if item.Exists {
								<span class="badge neutral">Already added</span>
							}
						</li>
					}
					if len(detected) == 0 {
						<li class="detect-empty">No folders found on disk.</li>
					}
				</ul>
				<div class="detect-actions">
					<a class="button secondary" href="/projects">Cancel</a>
					<button class="button primary" type="submit">Add selected</button>
				</div>
			</form>
		</div>
	</div>
}

templ PortsPage(data PortsPageData) {
	@layouts.Shell("Port management", data.Path, portsBody(data))
}

templ portsBody(data PortsPageData) {
	<div class="page-heading ports-page-heading">
		<div>
			<h1>Port management</h1>
			<p>See which ports are in use and which project owns them.</p>
		</div>
		<a class="button secondary" href="/ports">Refresh scan</a>
	</div>
	<section class="panel ports-panel">
		<div class="ports-panel-intro">
			<div>
				<strong>Current scan</strong>
				<p>Visibility only. PortD does not resolve conflicts automatically.</p>
			</div>
			<div class="ports-scan-meta">
				if data.CheckedAt != "" {
					<span>Last checked <strong>{ data.CheckedAt }</strong></span>
				}
				if data.Unknown > 0 {
					<span class="badge warning">{ data.Unknown } unregistered</span>
				}
			</div>
		</div>
		<div class="panel-body table-wrap">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Port</th>
						<th>Process</th>
						<th>Registered project</th>
						<th>Intern</th>
						<th>State</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr>
							<td><code class="hub-code">{ row.Port }</code></td>
							<td>{ row.Process }</td>
							<td>
								if row.Registered {
									<a class="project-name" href={ "/projects/" + row.ProjectSlug }>{ row.Project }</a>
								} else {
									—
								}
							</td>
							<td>{ row.Interns }</td>
							<td>
								if row.Registered {
									<span class="badge running">Registered</span>
								} else {
									<span class="badge warning">Unregistered</span>
								}
							</td>
						</tr>
					}
					if len(data.Rows) == 0 {
						<tr>
							<td colspan="5">
								<div class="empty-state">No port data available. Click Refresh to scan.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="panel ports-panel">
		<div class="ports-panel-intro">
			<div>
				<strong>Reserved, not listening</strong>
				<p>Allocated to a project but no process found on the OS. Usually a stopped project.</p>
			</div>
			<div class="ports-scan-meta">
				if len(data.Reserved) > 0 {
					<span class="badge neutral">{ strconv.Itoa(len(data.Reserved)) } reserved</span>
				}
			</div>
		</div>
		<div class="panel-body table-wrap">
			<table class="hub-table">
				<thead>
					<tr>
						<th>Port</th>
						<th>Registered project</th>
						<th>Intern</th>
						<th>State</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Reserved {
						<tr>
							<td><code class="hub-code">{ row.Port }</code></td>
							<td>
								<a class="project-name" href={ "/projects/" + row.ProjectSlug }>{ row.Project }</a>
							</td>
							<td>{ row.Interns }</td>
							<td><span class="badge neutral">Reserved</span></td>
						</tr>
					}
					if len(data.Reserved) == 0 {
						<tr>
							<td colspan="4">
								<div class="empty-state">No reserved ports. Every allocated port is listening.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ ProjectFormPage(data ProjectFormData) {
	@layouts.Shell(data.Title, data.Path, projectFormBody(data))
}

templ ProjectDetailPage(data ProjectDetailData) {
	@layouts.Shell(data.Name, data.Path, projectDetailBody(data))
}

templ projectDetailBody(data ProjectDetailData) {
	<div class="project-detail">
		<a class="breadcrumb" href="/projects">Projects / <span>{ data.Name }</span></a>
		<div class="project-hero">
			<div>
				<div class="title-row">
					<h1>{ data.Name }</h1>
					<span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span>
					<span class={ "state-pill " + data.LifecycleClass }>{ data.LifecycleLabel }</span>
				</div>
				<a href={ data.URL } target="_blank" rel="noreferrer">{ data.URLLabel } ↗</a>
				<p class="project-hero-meta">Owned by { data.Owners } · Main port <code class="hub-code">{ data.MainPort }</code></p>
				if data.Description != "" {
					<p>{ data.Description }</p>
				}
			</div>
			<div class="project-hero-actions">
				<a class="button secondary" href={ "/projects/" + data.Slug + "/edit" }>Edit</a>
				<a class="button primary" href={ data.URL } target="_blank" rel="noreferrer">Open project ↗</a>
			</div>
		</div>
		<div class="detail-grid">
			<section class="panel detail-panel">
				<div class="panel-head"><h2>Project details</h2></div>
				<dl class="hub-dl">
					<div>
						<dt>Owner</dt>
						<dd>{ data.Owners }</dd>
					</div>
					<div>
						<dt>Created</dt>
						<dd>{ data.CreatedAt }</dd>
					</div>
					<div>
						<dt>Last updated</dt>
						<dd>{ data.UpdatedAt }</dd>
					</div>
				</dl>
			</section>
			<section class="panel detail-panel">
				<div class="panel-head">
					<div>
						<h2>Runtime</h2>
						<p>Start or stop the project using its platform startup file.</p>
					</div>
					<span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span>
				</div>
				<div class="panel-body panel-body-padded runtime-control">
					if data.RuntimeError != "" {
						<div class="runtime-alert" role="alert">{ data.RuntimeError }</div>
					}
					<div class="runtime-control-row">
						<div>
							<strong>{ data.RuntimeState }</strong>
							if data.RuntimePID != "0" {
								<p>Process <code class="hub-code">#{ data.RuntimePID }</code> is managed by PortD.</p>
							} else {
								<p>No managed process is running.</p>
							}
						</div>
						if data.RuntimeState == "running" || data.RuntimeState == "stopping" {
							<form method="post" action={ "/projects/" + data.Slug + "/runtime/stop" } x-data="{ busy: false }" @submit="busy = true">
								<button class="button danger" type="submit" :disabled="busy || '{ data.RuntimeState }' === 'stopping'">
									<span x-show="!busy">Stop project</span><span x-show="busy" x-cloak>Stopping…</span>
								</button>
							</form>
						} else {
							<form method="post" action={ "/projects/" + data.Slug + "/runtime/start" } x-data="{ busy: false }" @submit="busy = true">
								<button class="button primary" type="submit" :disabled="busy || '{ data.RuntimeState }' === 'starting'">
									<span x-show="!busy">Start project</span><span x-show="busy" x-cloak>Starting…</span>
								</button>
							</form>
						}
					</div>
					<div class="runtime-file">
						<span>Execution file</span>
						<code class="hub-code">{ data.RuntimeFile }</code>
						if data.MissingStartup {
							<span class="badge warning">No start.sh or start.bat in the project directory</span>
						}
						<form class="runtime-configure" method="post" action={ "/projects/" + data.Slug + "/runtime/configure" }>
							<label class="sr-only" for="startup-command">Startup file path</label>
							<input id="startup-command" name="startup_command" value={ data.RuntimeFile } placeholder="start.sh or start.bat" autocomplete="off"/>
							<button class="button secondary" type="submit">Save file</button>
						</form>
						if data.RuntimeState == "failed" {
							<p class="runtime-error">The process exited unexpectedly. Check the file and project logs before trying again.</p>
						}
					</div>
				</div>
				<dl class="hub-dl four-up">
					<div>
						<dt>Main port</dt>
						<dd><code class="hub-code">{ data.MainPort }</code></dd>
					</div>
					<div>
						<dt>Status</dt>
						<dd><span class={ "badge " + data.StatusClass }>{ data.StatusLabel }</span></dd>
					</div>
					<div>
						<dt>Observed</dt>
						<dd>
							if data.IsLive {
								<span class="badge running">Live</span>
							} else {
								<span class="badge neutral">Not live</span>
							}
						</dd>
					</div>
				</dl>
			</section>
		</div>
		<section class="panel detail-panel access-panel" x-data="{ selectedFramework: '', copied: false }">
			<div class="panel-head">
				<div>
					<h2>Project access</h2>
					<p>Choose the URL that matches how your application handles its base path.</p>
				</div>
				<span class="badge neutral">{ data.Access.ModeLabel }</span>
			</div>
			<div class="panel-body panel-body-padded">
				<div class="access-options">
					<div class="access-option" data-active?={ data.Access.Mode == "direct" }>
						<div class="access-option-head"><strong>Direct</strong><span class="state-pill ready">No app changes</span></div>
						<code class="hub-code access-url">{ data.Access.DirectURL }</code>
						<p>Uses the server and main port directly. No Caddy, DNS, or base-path configuration is required.</p>
						<a class="button secondary" href={ data.Access.DirectURL } target="_blank" rel="noreferrer">Open direct URL ↗</a>
					</div>
					<div class="access-option" data-active?={ data.Access.Mode == "proxied" }>
						<div class="access-option-head"><strong>Proxied</strong><span class="state-pill ready">Path-based</span></div>
						<code class="hub-code access-url">{ data.Access.ProxiedURL }</code>
						<p>Uses the shared PortD URL. Configure your app's base path for in-app navigation and assets.</p>
						<a class="button secondary" href={ data.Access.ProxiedURL } target="_blank" rel="noreferrer">Open proxied URL ↗</a>
					</div>
				</div>
				<div class="quickstarts">
					<div class="panel-head access-subhead">
						<div><h3>Framework quickstarts</h3><p>Select your framework to see the one-line setup.</p></div>
					</div>
					<div class="quickstart-grid">
						for _, item := range data.Access.Quickstarts {
							<button class="quickstart" type="button" :class={ "selectedFramework === '" + item.Key + "' ? 'is-selected' : ''" } @click={ "selectedFramework = '" + item.Key + "'" }>
								<div class="quickstart-title">
									<strong>{ item.Name }</strong>
									if item.NoConfig {
										<span class="state-pill ready">No config</span>
									} else {
										<span class="state-pill draft">Config</span>
									}
								</div>
								<p>{ item.Description }</p>
								<span class="quickstart-action">View setup →</span>
							</button>
						}
					</div>
				</div>
				<div class="quickstart-instructions" x-cloak x-show="selectedFramework !== ''">
					for _, item := range data.Access.Quickstarts {
						<div class="quickstart-instruction" x-show={ "selectedFramework === '" + item.Key + "'" }>
							<div class="quickstart-instruction-head">
								<div><strong>{ item.Name }</strong><p>{ item.Description }</p><span class="quickstart-file">Edit <code>{ item.File }</code></span></div>
								<button class="table-action" type="button" @click="navigator.clipboard.writeText($el.closest('.quickstart-instruction').querySelector('.quickstart-code').textContent); copied = true">Copy setup</button>
							</div>
							<pre class="quickstart-code"><code>{ item.Snippet }</code></pre>
						</div>
					}
				</div>
				<div class="ai-help">
					<div>
						<strong>Not sure what to do?</strong>
						<p>Paste this prompt into your AI coding agent and it will guide you through the smallest framework-specific change.</p>
					</div>
					<textarea class="ai-prompt" readonly x-ref="aiPrompt">{ data.Access.AIPrompt }</textarea>
					<button class="button secondary" type="button" @click="navigator.clipboard.writeText($refs.aiPrompt.value); copied = true">Copy prompt</button>
				</div>
				<p class="access-fallback"><strong>Navigation broken under Proxied?</strong> Use Direct mode from Edit, or open the direct URL above without changing your project.</p>
			</div>
		</section>
		<section class="panel detail-panel">
			<div class="panel-head">
				<div>
					<h2>Ports</h2>
					<p>Only the main port gets a public link. Allocate or release on the <a class="table-action" href={ "/projects/" + data.Slug + "/edit" }>Edit page</a>.</p>
				</div>
			</div>
			<div class="panel-body panel-body-padded">
				if data.PortError != "" {
					<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
						{ data.PortError }
					</div>
				}
				if len(data.AllocatedPorts) == 0 {
					<p class="text-sm text-brand-muted">No ports assigned yet.</p>
				} else {
					<ul class="flex flex-col gap-2">
						for _, port := range data.AllocatedPorts {
							<li class="flex flex-wrap items-center gap-2">
								<code class="hub-code">{ port.Port }</code>
								if port.IsMain {
									<span class="port main">main</span>
								} else {
									<span class="port">internal</span>
									<form method="post" action={ "/projects/" + data.Slug + "/ports/promote" }>
										<input type="hidden" name="port" value={ port.Port }/>
										<input type="hidden" name="next" value={ "/projects/" + data.Slug }/>
										<button class="table-action" type="submit">Make main</button>
									</form>
								}
								if port.Live {
									<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green">
										<span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
										Live
									</span>
								}
							</li>
						}
					</ul>
				}
			</div>
		</section>
		<section class="panel detail-panel">
			<div class="panel-head">
				<div>
					<h2>Healthchecks</h2>
					<p>Endpoints the checker will probe. Stored only for now.</p>
				</div>
			</div>
			<div class="panel-body panel-body-padded">
				if data.HealthError != "" {
					<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
						{ data.HealthError }
					</div>
				}
				if len(data.Healthchecks) == 0 {
					<p class="text-sm text-brand-muted mb-4">No endpoints yet.</p>
				} else {
					<ul class="flex flex-col gap-2 mb-4">
						for _, check := range data.Healthchecks {
							<li class="flex flex-wrap items-center gap-2">
								<code class="hub-code">{ check.Endpoint }</code>
								<span class="port">→ { check.Expected }</span>
								<form method="post" action={ "/projects/" + data.Slug + "/healthchecks/" + check.ID + "/delete" }>
									<input type="hidden" name="next" value={ "/projects/" + data.Slug }/>
									<button class="table-action" type="submit">Remove</button>
								</form>
							</li>
						}
					</ul>
				}
				<form class="flex flex-wrap items-end gap-2" method="post" action={ "/projects/" + data.Slug + "/healthchecks" }>
					<input type="hidden" name="next" value={ "/projects/" + data.Slug }/>
					<label class="block text-sm font-bold text-slate-700">
						Endpoint
						<input class="mt-1 block w-64 max-w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-mono font-normal" name="endpoint" maxlength="2048" placeholder="/health"/>
					</label>
					<label class="block text-sm font-bold text-slate-700">
						Expect
						<input class="mt-1 block w-24 px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal" name="expected_status" type="number" min="200" max="599" placeholder="200"/>
					</label>
					<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer" type="submit">Add</button>
				</form>
			</div>
		</section>
		<section class="panel detail-panel tracking-panel">
			<div class="panel-head"><h2>Project tracking</h2></div>
			<div class="tracking-card-body">
				<div class="tracking-topline">
					<span class={ "state-pill " + data.LifecycleClass }>{ data.LifecycleLabel }</span>
					<strong>{ data.LifecyclePhase }</strong>
				</div>
				<div class="tracking-meta">
					<div>
						<span>Last update</span>
						<strong>{ data.UpdatedAt }</strong>
					</div>
					<div>
						<span>Runtime intent</span>
						<strong>{ data.RuntimeIntent }</strong>
					</div>
				</div>
			</div>
		</section>
		<section class="panel detail-panel">
			<div class="panel-head"><h2>How to run this project</h2></div>
			<div class="panel-body panel-body-padded">
				<ol class="flex flex-col gap-4 list-decimal ml-5 marker:font-bold marker:text-brand-navy">
					<li>
						<strong>Work in your folder.</strong>
						<span class="text-brand-muted">All files live in <code class="hub-code">{ data.Directory }</code>.</span>
					</li>
					<li>
						<strong>Bind your main port.</strong>
						if data.MainPort != "—" {
							<span class="text-brand-muted">Listen on <code class="hub-code">localhost:{ data.MainPort }</code>. Assigned ports only — never take another project's.</span>
						} else {
							<span class="text-brand-muted">Listen on your main port (see Ports above). Assigned ports only — never take another project's.</span>
						}
					</li>
					<li>
						<strong>Start it.</strong>
						<span class="text-brand-muted">Run <code class="hub-code">{ data.StartupCommand }</code>. Toggle Should run on the Edit page to stop or restart.</span>
					</li>
					<li>
						<strong>Read the README first.</strong>
						<span class="text-brand-muted">It lists your ports and URL.</span>
					</li>
				</ol>
			</div>
		</section>
		<section class="panel detail-panel" x-data="{ confirmArchive: false }">
			<div class="panel-head"><h2>Project setup</h2></div>
			<dl class="hub-dl setup">
				<div>
					<dt>Directory</dt>
					<dd><code class="hub-code">{ data.Directory }</code></dd>
				</div>
				<div>
					<dt>Entry point</dt>
					<dd><code class="hub-code">{ data.StartupCommand }</code></dd>
				</div>
			</dl>
			if !data.Archived {
				<div class="archive">
					<div class="archive-label">
						<h3>Archive project</h3>
						<p>This hides the project from active discovery and frees its assigned ports to the shared pool.</p>
					</div>
					<button class="link-danger" type="button" @click="confirmArchive = true" x-show="!confirmArchive">Archive</button>
				</div>
				<div class="archive-confirm" x-show="confirmArchive" x-cloak>
					<p>This action hides the project and frees its ports. Lifecycle can be changed later from Edit.</p>
					<div class="archive-confirm-actions">
						<button class="button secondary" type="button" @click="confirmArchive = false">Cancel</button>
						<form method="post" action={ "/projects/" + data.Slug + "/archive" }>
							<button class="button danger" type="submit">Confirm archive</button>
						</form>
					</div>
				</div>
			} else {
				<div class="archive">
					<div class="archive-label">
						<h3>Archived</h3>
						<p>This project is archived.</p>
					</div>
				</div>
			}
		</section>
	</div>
}

templ projectFormBody(data ProjectFormData) {
	if data.IsNew {
		<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3" href="/projects">← Projects</a>
	} else {
		<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3" href={ "/projects/" + data.Slug }>← { data.Name }</a>
	}
	<h1 class="text-2xl font-bold text-brand-navy mb-4">{ data.Title }</h1>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4" method="post" action={ data.Action } x-data="{ busy: false, shouldRun: true }" x-init={ "shouldRun = " + activeJS(data.ShouldRun) } @submit="busy = true">
		<label class="block text-sm font-bold text-slate-700">
			Name
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="name" required minlength="2" maxlength="80" value={ data.Name }/>
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Slug
			if data.IsNew {
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="slug" pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$" value={ data.Slug } placeholder="Derived from name when empty"/>
			} else {
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md bg-slate-50 text-slate-600 font-normal" name="slug" value={ data.Slug } readonly/>
			}
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Description
			<textarea class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors min-h-[96px]" name="description" maxlength="4000">{ data.Description }</textarea>
		</label>
		<fieldset class="block">
			<legend class="text-sm font-bold text-slate-700 mb-2">Assigned interns</legend>
			if len(data.Interns) == 0 {
				<p class="text-sm text-brand-muted">No active interns available. Create an intern first.</p>
			} else {
				<div class="space-y-2 max-h-48 overflow-y-auto border border-slate-200 rounded-md p-3">
					for _, intern := range data.Interns {
						<label class="flex items-center gap-2 text-sm font-medium text-slate-700">
							<input class="rounded border-slate-300 text-brand-blue focus:ring-brand-blue/20" type="checkbox" name="intern_ids" value={ intern.ID } checked?={ intern.Selected }/>
							{ intern.FullName }
						</label>
					}
				</div>
			}
		</fieldset>
		<label class="block text-sm font-bold text-slate-700">
			Lifecycle
			<select name="lifecycle_status" class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer">
				<option value="draft" selected?={ data.LifecycleStatus == "" || data.LifecycleStatus == "draft" }>Draft</option>
				<option value="ready" selected?={ data.LifecycleStatus == "ready" }>Ready</option>
				<option value="running" selected?={ data.LifecycleStatus == "running" }>Running</option>
				<option value="stopped" selected?={ data.LifecycleStatus == "stopped" }>Stopped</option>
				<option value="failed" selected?={ data.LifecycleStatus == "failed" }>Failed</option>
				<option value="archived" selected?={ data.LifecycleStatus == "archived" }>Archived</option>
			</select>
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Access mode
			<select name="access_mode" class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md text-slate-700 font-semibold bg-white focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none cursor-pointer">
				<option value="direct" selected?={ data.AccessMode == "" || data.AccessMode == "direct" }>Direct — server and main port</option>
				<option value="proxied" selected?={ data.AccessMode == "proxied" }>Proxied — shared project URL</option>
			</select>
			<span class="mt-1 block text-xs text-brand-muted">Direct is the compatibility-first default. Proxied may require a framework base path.</span>
		</label>
		if data.IsNew {
			<label class="block text-sm font-bold text-slate-700">
				Ports needed
				<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="ports_needed" type="number" min="1" max="5" value={ strconv.Itoa(portCountOrDefault(data.PortCount)) }/>
			</label>
		}
		<div class="flex flex-wrap items-center gap-3">
			<input type="hidden" name="should_run" :value="shouldRun ? 'true' : 'false'"/>
			<button
				type="button"
				@click="shouldRun = !shouldRun"
				:class="shouldRun ? 'bg-brand-green-soft hover:bg-green-100 border-green-300 text-brand-green' : 'bg-slate-50 hover:bg-slate-100 border-slate-300 text-slate-700'"
				class="inline-flex items-center gap-1.5 justify-center min-h-[36px] px-4 py-2 border text-sm font-bold rounded-lg transition-colors cursor-pointer"
			>
				<span class="w-1.5 h-1.5 rounded-full" :class="shouldRun ? 'bg-brand-green' : 'bg-slate-400'"></span>
				<span x-text="shouldRun ? 'Should run: on' : 'Should run: off'"></span>
			</button>
			if !data.IsNew {
				if data.IsLive {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green">Observed: live</span>
				} else {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600">Observed: not live</span>
				}
			}
		</div>
		<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">
			if data.IsNew {
				Create project
			} else {
				Save project
			}
		</button>
	</form>
	if !data.IsNew {
		@projectPortsPanel(data)
	}
}

templ projectPortsPanel(data ProjectFormData) {
	<section class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm mt-6" x-data="{ confirming: '' }">
		<h2 class="text-base font-bold text-brand-navy">Ports</h2>
		<p class="text-brand-muted text-sm mt-0.5 mb-4">Allocate more, claim a specific port, or release one you no longer need.</p>
		if data.PortError != "" {
			<div class="p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
				{ data.PortError }
			</div>
		}
		if len(data.Ports) == 0 {
			<p class="text-sm text-brand-muted mb-4">No ports assigned yet.</p>
		} else {
			<ul class="flex flex-col gap-2 mb-5">
				for _, port := range data.Ports {
					<li class="flex flex-wrap items-center gap-2">
						<code class="hub-code">{ port.Port }</code>
						if port.IsMain {
							<span class="port main">main</span>
							<span class="text-xs text-brand-muted">Promote another port first to release this one.</span>
						} else {
							<span class="port">internal</span>
							<form method="post" action={ "/projects/" + data.Slug + "/ports/release" } x-show="confirming !== '{ port.Port }'">
								<input type="hidden" name="port" value={ port.Port }/>
								<input type="hidden" name="next" value={ "/projects/" + data.Slug + "/edit" }/>
								<button class="link-danger" type="button" @click={ "confirming = '" + port.Port + "'" }>Release</button>
							</form>
							<div class="flex items-center gap-2" x-show={ "confirming === '" + port.Port + "'" } x-cloak>
								<span class="text-sm text-slate-600">Release { port.Port }?</span>
								<form method="post" action={ "/projects/" + data.Slug + "/ports/release" }>
									<input type="hidden" name="port" value={ port.Port }/>
									<input type="hidden" name="next" value={ "/projects/" + data.Slug + "/edit" }/>
									<button class="button danger" type="submit">Confirm</button>
								</form>
								<button class="button secondary" type="button" @click="confirming = ''">Cancel</button>
							</div>
						}
						if port.Live {
							<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-green-soft text-brand-green">
								<span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
								Live
							</span>
						}
					</li>
				}
			</ul>
		}
		<div class="flex flex-col gap-4">
			<form class="flex flex-wrap items-end gap-2" method="post" action={ "/projects/" + data.Slug + "/ports/allocate" }>
				<input type="hidden" name="next" value={ "/projects/" + data.Slug + "/edit" }/>
				<label class="block text-sm font-bold text-slate-700">
					More ports
					<input class="mt-1 block w-24 px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal" name="count" type="number" min="1" max="5" value="1"/>
				</label>
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer" type="submit">Allocate</button>
			</form>
			<form class="flex flex-wrap items-end gap-2" method="post" action={ "/projects/" + data.Slug + "/ports/claim" }>
				<input type="hidden" name="next" value={ "/projects/" + data.Slug + "/edit" }/>
				<label class="block text-sm font-bold text-slate-700">
					Specific port
					<input class="mt-1 block w-28 px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-mono font-normal" name="port" type="number" min="3000" max="9999" placeholder="3000"/>
				</label>
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold rounded-lg transition-colors cursor-pointer" type="submit">Claim</button>
			</form>
		</div>
	</section>
}

templ InternFormPage(data InternFormData) {
	@layouts.Shell(data.Title, data.Path, internFormBody(data))
}

templ internFormBody(data InternFormData) {
	<a class="inline-flex items-center text-sm font-semibold text-brand-blue hover:underline mb-3" href="/interns">← Interns</a>
	<h1 class="text-2xl font-bold text-brand-navy mb-4">{ data.Title }</h1>
	if data.Error != "" {
		<div class="max-w-xl p-3 mb-4 rounded-lg bg-red-50 border border-red-200 text-brand-red text-sm font-medium" role="alert">
			{ data.Error }
		</div>
	}
	<form class="max-w-xl bg-white border border-brand-line rounded-lg p-6 shadow-sm space-y-4" method="post" action={ data.Action } x-data="{ busy: false, active: true }" x-init={ "active = " + activeJS(data.Active) } @submit="busy = true">
		<label class="block text-sm font-bold text-slate-700">
			Full name
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="full_name" required value={ data.FullName }/>
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Username
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" name="identifier" required value={ data.Identifier }/>
		</label>
		<label class="block text-sm font-bold text-slate-700">
			Email
			<input class="mt-1.5 block w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none text-slate-800 font-normal transition-colors" type="email" name="email" value={ data.Email }/>
		</label>
		if data.IsNew {
			<label class="block text-sm font-bold text-slate-700">
				Password
				@components.PasswordField("password", "new-password", true)
			</label>
			<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Save intern</button>
		} else {
			<div class="flex flex-wrap items-center gap-3">
				<input type="hidden" name="active" :value="active ? 'true' : 'false'"/>
				<button class="inline-flex items-center justify-center min-h-[36px] px-4 py-2 bg-brand-blue hover:bg-brand-blue-hover disabled:opacity-50 text-white text-sm font-bold rounded-lg transition-colors cursor-pointer disabled:cursor-not-allowed shadow-sm" :disabled="busy">Save intern</button>
				<button
					type="button"
					@click="active = !active"
					:class="active ? 'bg-red-50 hover:bg-red-100 border-red-300 text-brand-red' : 'bg-green-50 hover:bg-green-100 border-green-300 text-brand-green'"
					class="inline-flex items-center gap-1.5 justify-center min-h-[36px] px-4 py-2 border text-sm font-bold rounded-lg transition-colors cursor-pointer"
				>
					<span class="w-1.5 h-1.5 rounded-full" :class="active ? 'bg-brand-red' : 'bg-brand-green'"></span>
					<span x-text="active ? 'Deactivate account' : 'Activate account'"></span>
				</button>
			</div>
		}
	</form>
}
